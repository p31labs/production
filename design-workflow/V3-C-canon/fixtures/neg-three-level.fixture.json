{
  "name": "neg-control-three-level-chain",
  "description": "C2 negative control (ii): 3-level chain base → child → grandchild. grandchild's $extends target (child) is itself extended → depth 2 > 1 → R5 FAIL.",
  "brands": [
    {
      "name": "base",
      "versionPolicy": "exact",
      "tokens": {
        "radius-sm": { "$value": { "value": 8, "unit": "px" }, "$type": "dimension" },
        "accent": { "$value": { "colorSpace": "oklch", "components": [0.65, 0.18, 195] }, "$type": "color" }
      }
    },
    {
      "name": "child",
      "$extends": ["base"],
      "versionPolicy": "minor",
      "tokens": {
        "radius-sm": { "$value": { "value": 10, "unit": "px" }, "$type": "dimension" },
        "accent": { "$value": { "colorSpace": "oklch", "components": [0.7, 0.15, 145] }, "$type": "color" }
      }
    },
    {
      "name": "grandchild",
      "$extends": ["child"],
      "versionPolicy": "latest",
      "tokens": {
        "radius-sm": { "$value": { "value": 12, "unit": "px" }, "$type": "dimension" },
        "accent": { "$value": { "colorSpace": "oklch", "components": [0.75, 0.12, 120] }, "$type": "color" }
      }
    }
  ]
}