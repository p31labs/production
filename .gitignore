# Dependencies & build output
node_modules/
dist/
.next/

# Env files — keep examples only
.env
.env.*
!.env.example
!.env.local.example
!.env.go-live.example
!.env.production

# Secrets & admin tokens
.admin_token
*.token
credentials.json
secret*

# Wrangler local secrets — never track values; keep .dev.vars.example only
.dev.vars
!.dev.vars.example

# Logs, caches, OS noise
npm-debug.log*
.pnpm-debug.log*
*.log
.cache/
.tmp/
.DS_Store
Thumbs.db

# Workers runtime artifacts
worker-configuration.d.ts

# Workers node_modules (symlinks)
**/workers/*/node_modules/

# Editor / IDE
.idea/
.vscode/

# opencode operational state — keys, ledger, tokens (contains secrets)
.workspace/
.opencode/

# Monorepo build artifacts
.pnpm-store/
build/
out/
.turbo/
.wrangler/
coverage/
*.tsbuildinfo
*.bundle
playwright-report/
test-results/

# Large model/training archives (not source; exceed Git's 100 MB limit)
*.tar

# Runtime logs
logs/

# Service credentials & MCP auth keys
.smithery.key
.mcp-auth/

# Android release keystores — never track signing keys (see docs/fix-plans/monetization-android-release-keystore-committed)
*.keystore
*.jks

# Bootstrap wallet material — contains private keys (see docs/fix-plans/monetization-bootstrap-payer-private-key)
.bootstrap-payer.json
.bootstrap-*.json

# Standalone nested repo — p31-capital-machine has its own .git (see docs/fix-plans/capital-machine-standalone-repo-hygiene)
p31-capital-machine/

# Regenerable Gradle wrapper (build tooling, not source)
monetization/mobile/android/gradle/wrapper/
