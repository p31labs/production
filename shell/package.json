    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "hex-gate": "if grep -Er \"#[0-9a-fA-F]{6}\" src/features/sandbox src/pages/SandboxPage.tsx | grep -vE \"#0f1217|#d0d0d8|#000000\" | grep -q .; then echo 'HEX GATE FAILED: hardcoded hex in sandbox code'; grep -Er \"#[0-9a-fA-F]{6}\" src/features/sandbox src/pages/SandboxPage.tsx | grep -vE \"#0f1217|#d0d0d8|#000000\"; exit 1; else echo 'hex gate: sandbox clean'; fi",
