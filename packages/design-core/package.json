{
  "name": "@p31ca/design-core",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "P31 Unified Design System — Quantum Material (OKLCH/color-mix) token stance, tokens, primitives, compositions, recipes, MCP server, agentic intent pipeline.",
  "author": "P31 Labs <hello@p31ca.org>",
  "license": "AGPL-3.0",
  "exports": {
    ".": "./src/index.ts",
    "./a2ui/DataCard": "./src/a2ui/DataCard.tsx",
    "./tokens": "./src/tokens/index.ts",
    "./math": "./src/math/index.ts",
    "./compositions": "./src/compositions/index.ts",
    "./shell": "./src/shell/index.ts",
    "./primitives": "./src/primitives/index.ts",
    "./agentic": "./src/agentic/index.ts",
    "./agentic/orchestrate": "./src/agentic/orchestrate.ts",
    "./theming/theme-store": "./src/theming/theme-store.ts",
    "./css/a2ui-datacard.css": "./src/css/a2ui-datacard.css",
    "./css/all.css": "./src/css/all.css",
    "./css/ambient.css": "./src/css/ambient.css",
    "./css/base.css": "./src/css/base.css",
    "./css/canon.css": "./src/css/canon.css",
    "./css/container.css": "./src/css/container.css",
    "./css/glass.css": "./src/css/glass.css",
    "./css/layout.css": "./src/css/layout.css",
    "./css/link-glow.css": "./src/css/link-glow.css",
    "./css/motion.css": "./src/css/motion.css",
    "./css/quantum.css": "./src/css/quantum.css",
    "./css/recipes.css": "./src/css/recipes.css",
    "./css/theme-p31ca.css": "./src/css/theme-p31ca.css",
    "./css/theme-phosphorus31.css": "./src/css/theme-phosphorus31.css",
    "./css/size-class.css": "./src/css/size-class.css",
    "./css/typography.css": "./src/css/typography.css",
    "./generated/*": "./src/generated/*.tsx",
    "./starfield": "./src/starfield.ts",
    "./starfield/jitterbug": "./src/starfield/jitterbug.ts",
    "./crisis-overlay": "./src/crisis-overlay.ts",
    "./genui": "./src/genui/catalog.ts",
    "./genui/catalog": "./src/genui/catalog.ts",
    "./mcp": "./src/mcp/server.ts",
    "./mcp/browser-dispatcher": "./src/mcp/browser-dispatcher.js",
    "./mcp/data": "./src/mcp/data.ts",
    "./componentDefs": "./src/componentDefs.ts",
    "./converter": "./src/converter/index.ts",
    "./generator": "./src/generator/componentGenerator.ts",
    "./generator/astro": "./src/generator/componentGenerator.astro.ts",
    "./generator/html": "./src/generator/componentGenerator.html.ts",
    "./generator/wc": "./src/generator/componentGenerator.wc.ts",
    "./manifest.json": "./manifest.json",
    "./css/chrome.css": "./src/css/chrome.css",
    "./css/shell.css": "./src/css/shell.css",
    "./css/index.css": "./src/css/index.css"
  },
  "peerDependencies": {
    "@p31ca/canon": ">=0.1.0",
    "react": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "@types/culori": "^4.0.1",
    "@types/react": "^19.0.0",
    "astro": "^5.18.1",
    "css-tree": "^3.1.0",
    "culori": "^4.0.2",
    "esprima": "^4.0.1",
    "fs-extra": "^11.2.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "yaml": "^2.6.1",
    "zod": "^3.23.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-mcp": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tokens-studio/sd-transforms": "1.3.0",
    "@types/css-tree": "^3.0.1",
    "@types/esprima": "^4.0.3",
    "@types/fs-extra": "^11.0.4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20.0.0",
    "ajv": "^8.20.0",
    "storybook": "^10.6.0",
    "style-dictionary": "^5.5.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "gen:tokens": "style-dictionary build --config gen/style-dictionary.config.mjs && tsx scripts/gen-tokens.mts && node scripts/canon-purity.mjs",
    "mcp": "tsx src/mcp/server.ts",
    "convert": "tsx src/converter/cli.ts",
    "generate": "tsx scripts/generate-components.ts --all",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:manifest": "storybook build -o storybook-static && tsx scripts/storybook-to-catalog.mts",
    "audit:components": "node src/audit-components.mjs",
    "audit:semantic": "node src/audit-semantic-classes.mjs",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "canon-purity": "node scripts/canon-purity.mjs",
    "gate": "npm run canon-purity && npm run tokens:validate && npm run typecheck && npm run test && npm run build",
    "tokens:validate": "node ../../tools/token-validation/src/validate.mjs",
    "registry:gen": "node scripts/gen-registry.mjs",
    "registry:check": "node scripts/gen-registry.mjs --check",
    "p31ca": "node cli/p31ca.mjs"
  }
}
