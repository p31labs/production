---
interface Props {
  strong?: boolean;
  href?: string;
  class?: string;
}

const { strong = false, href, class: className = '' } = Astro.props;
---
{
  href ? (
    <a href={href} class:list={['glass-card', strong && 'glass-strong', className]}>
      <slot />
    </a>
  ) : (
    <div class:list={['glass-card', strong && 'glass-strong', className]}>
      <slot />
    </div>
  )
}
