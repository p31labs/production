---
interface Props {
  padding?: 'sm' | 'md' | 'lg';
  strong?: boolean;
  class?: string;
}

const { padding = 'md', strong = false, class: className = '' } = Astro.props;
const paddingClasses = { sm: 'p-4', md: 'p-6', lg: 'p-8' };
---
<div class:list={['glass-panel', strong && 'glass-strong', paddingClasses[padding], className]}>
  <slot />
</div>
