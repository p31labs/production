{
  "name": "@p31ca/sovereign-primitives",
  "version": "0.0.2",
  "private": false,
  "type": "module",
  "description": "Identity and cryptographic primitives for the P31 Labs ecosystem",
  "author": "P31 Labs <willyj1587@gmail.com>",
  "license": "MIT",
  "homepage": "https://p31ca.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/p31labs/andromeda.git",
    "directory": "packages/sovereign-primitives"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "prepublishOnly": "npm run clean && npm run build && npm run test"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/capabilityToken.js",
    "dist/capabilityToken.d.ts",
    "dist/composite.js",
    "dist/composite.d.ts",
    "dist/postQuantum.js",
    "dist/postQuantum.d.ts",
    "dist/crypto.js",
    "dist/crypto.d.ts",
    "dist/audioEngine.js",
    "dist/audioEngine.d.ts",
    "dist/trust",
    "dist/pickle-names",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@noble/post-quantum": "^0.6.1"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./capability-token": {
      "types": "./dist/capabilityToken.d.ts",
      "import": "./dist/capabilityToken.js"
    },
    "./composite": {
      "types": "./dist/composite.d.ts",
      "import": "./dist/composite.js"
    },
    "./post-quantum": {
      "types": "./dist/postQuantum.d.ts",
      "import": "./dist/postQuantum.js"
    },
    "./pickle-names": {
      "types": "./dist/pickle-names/export.d.ts",
      "import": "./dist/pickle-names/export.js"
    }
  }
}
