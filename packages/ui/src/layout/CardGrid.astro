---
export type CardStatus = 'published' | 'peer-review' | 'preprint' | 'draft' | 'live' | 'dev' | 'prototype';

export interface Card {
  title: string;
  description?: string;
  href?: string;
  status?: CardStatus;
  statusLabel?: string;
  meta?: string;
  accent?: string; // hex color for the top border
}

const { cards, cols = 3 } = Astro.props;

const colClasses =
  cols === 2 ? 'sm:grid-cols-2'
  : cols === 4 ? 'sm:grid-cols-2 lg:grid-cols-4'
  : 'sm:grid-cols-2 lg:grid-cols-3';

// Static status -> { bg, color } (avoids dynamic Tailwind class purging)
const STATUS_STYLE: Record<string, { bg: string; color: string }> = {
  published:  { bg: 'rgba(52,211,153,0.15)', color: '#34D399' },
  'peer-review': { bg: 'rgba(251,191,36,0.15)', color: '#FBBF24' },
  preprint:   { bg: 'rgba(0,240,255,0.15)', color: '#00F0FF' },
  draft:      { bg: 'rgba(148,163,184,0.15)', color: '#94A3B8' },
  live:       { bg: 'rgba(52,211,153,0.15)', color: '#34D399' },
  dev:        { bg: 'rgba(251,191,36,0.15)', color: '#FBBF24' },
  prototype:  { bg: 'rgba(167,139,250,0.15)', color: '#A78BFA' },
};
---
<div class={`grid grid-cols-1 ${colClasses} gap-3`}>
  {cards.map((card) => {
    const style = card.status ? STATUS_STYLE[card.status] : undefined;
    const borderColor = card.accent ? `${card.accent}40` : (style ? style.color + '40' : 'rgba(255,255,255,0.08)');
    const inner = (
      <div
        class="glass-card p-4 rounded-xl block h-full transition hover:brightness-110"
        style={`border-top: 2px solid ${borderColor};`}
      >
        <div class="flex items-start justify-between gap-2">
          <h3 class="text-sm font-semibold text-[#F5F5F7] leading-snug">{card.title}</h3>
          {card.status && (
            <span
              class="text-[9px] font-mono px-1.5 py-0.5 rounded shrink-0"
              style={style ? { background: style.bg, color: style.color } : undefined}
            >{card.statusLabel ?? card.status}</span>
          )}
        </div>
        {card.description && <p class="text-xs text-white/40 mt-1 leading-relaxed">{card.description}</p>}
        {card.meta && <p class="text-[10px] text-white/20 mt-2 font-mono">{card.meta}</p>}
      </div>
    );
    return card.href ? (
      <a href={card.href} target={card.href.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer" class="no-underline link-glow block">{inner}</a>
    ) : (
      <div class="block">{inner}</div>
    );
  })}
</div>
