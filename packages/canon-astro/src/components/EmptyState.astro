---
import { emptyStateTree, renderHtml } from '@p31ca/canon-parts/markup';

interface Props {
  title: string;
  description?: string;
  class?: string;
  style?: Record<string, string | number>;
}

const { title, description, class: cls = '', style } = Astro.props;
const action = await Astro.slots.render('action');

const html = renderHtml(emptyStateTree({
  title,
  description,
  action: action ? { raw: action } : null,
  className: cls,
  style,
}));
---
<Fragment set:html={html} />