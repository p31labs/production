---
import { pageTree, renderHtml } from '@p31ca/canon-parts/markup';

interface Props {
  mode?: 'flow' | 'fill' | 'panel-scroll' | 'fit';
  class?: string;
  style?: Record<string, string | number>;
}

const { mode = 'flow', class: cls = '', style } = Astro.props;
const children = await Astro.slots.render('default');

const html = renderHtml(pageTree({
  mode,
  children: children ? { raw: children } : null,
  className: cls,
  style,
}));
---
<Fragment set:html={html} />