{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["vite/client", "@webgpu/types", "@types/web-bluetooth"],
    "lib": ["DOM", "ES2020"],
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      "@p31ca/design-core": ["../design-core/src/index.ts"],
      "@p31ca/design-core/*": ["../design-core/*"]
    }
  },
  "include": ["src", "src/types/**/*.d.ts"],
  "exclude": ["src/services/webgpu/**/*", "src/__tests__/**/*"]
}
