{
  "name": "@p31ca/game-engine",
  "version": "0.2.0-alpha.0",
  "description": "P31 game engine — Maxwell rigidity, jitterbug geometry, geodesic primitives, spoon-gated game runtime, Roblox adapter.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./geometry": "./src/geometry.ts",
    "./structures": "./src/structures.ts",
    "./challenges": "./src/challenges.ts",
    "./player": "./src/player.ts",
    "./engine": "./src/engine.ts",
    "./types": "./src/types.ts",
    "./jitterbug": "./src/jitterbug.ts",
    "./spoon-gated": "./src/spoon-gated.ts",
    "./react": "./src/react.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "p31",
    "geodesic",
    "maxwell",
    "rigidity",
    "fuller",
    "game-engine",
    "jitterbug"
  ],
  "author": "P31 Labs",
  "license": "MIT",
  "sideEffects": false,
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
