{
  "name": "@p31ca/brain-dump-orchestrator",
  "version": "0.1.0-alpha.0",
  "description": "Jitterbug Quantum Brain Dump orchestration: parallel axis execution with convergence gates",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./jitterbug": {
      "types": "./dist/jitterbug/index.d.ts",
      "import": "./dist/jitterbug/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "p31",
    "jitterbug",
    "brain-dump",
    "multi-agent",
    "orchestration",
    "convergence",
    "parallel-execution",
    "quantum",
    "agent-runtime"
  ],
  "author": "P31 Labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/p31labs/andromeda"
  },
  "homepage": "https://phosphorus31.org",
  "dependencies": {
    "@p31ca/shared": "workspace:*",
    "zod": "^3.24.0",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
