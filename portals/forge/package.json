{
  "name": "@p31-portals/forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:acceptance": "playwright test",
    "manifest": "node scripts/build-manifest.mjs",
    "gate": "node scripts/gate.mjs",
    "gate:self-test": "node tests/acceptance/gate-self-test.mjs",
    "check:registry-drift": "node tests/acceptance/check-gate-registry-drift.mjs",
    "system-test": "node scripts/system-test.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm gate"
  },
  "dependencies": {
    "motion": "^13.4.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^6.26.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.48.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.21.0",
    "eslint": "^9.15.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
