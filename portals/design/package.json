  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "wrangler pages deploy dist --project-name p31-portal-design --commit-dirty=true",
    "deploy:precheck": "node scripts/deploy-precheck.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:core": "cd ../../../P31-local-workspace/packages/design-core && pnpm test",
    "sync:vendor": "node scripts/sync-vendor.mjs && node scripts/sync-p31ca-ambient.mjs",
    "design": "tsx node_modules/@p31ca/design-core/src/agentic/cli.ts",
    "gen:tokens": "tsx node_modules/@p31ca/design-core/scripts/gen-tokens.mts",
    "v:gate": "node /home/p31/production/tools/portal-vendor-sync/v-gate.mjs --target /home/p31/production/portals/design",
    "build:pwa": "vite build && node scripts/token-presence.mjs && node scripts/contrast-audit.mjs && node scripts/spacing-audit.mjs && node scripts/surface-audit.mjs && node scripts/ambient-perf-audit.mjs && node scripts/css-integrity.mjs && node scripts/token-tier-audit.mjs && node scripts/undefined-class-audit.mjs && npx playwright test",
    "gate": "pnpm typecheck && pnpm lint && pnpm test && pnpm build:pwa && pnpm v:gate",
    "gate:self-test": "node tests/acceptance/gate-self-test.mjs",
    "check:image-distinctness": "node tests/acceptance/check-image-distinctness.mjs",
    "acceptance:ratchet": "node tests/acceptance/ratchet.mjs 5",
    "runbooks:check": "node ../../tools/runbooks-check.mjs",
    "audit:orphans": "node tests/acceptance/audit-orphans.mjs",
    "audit:derive": "node tests/acceptance/audit-derive.mjs",
    "audit:orphan-ratchet": "node tests/acceptance/run-orphan-ratchet.mjs"
  },
