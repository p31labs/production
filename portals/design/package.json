{
  "extends": "../template/package.json",
  "name": "@p31-portals/design",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "wrangler pages deploy dist --project-name p31-portal-design --commit-dirty=true",
    "typecheck": "tsc --noEmit && pnpm -C design-core typecheck",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:core": "pnpm -C design-core test",
    "design": "tsx design-core/src/agentic/cli.ts",
    "gen:tokens": "pnpm -C design-core gen:tokens"
  },
  "dependencies": {
    "@p31/design-core": "workspace:*",
    "@p31/ui": "^1.3.0",
    "lucide-react": "^0.400.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.8.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.4.2",
    "vitest": "^3.0.0"
  }
}
