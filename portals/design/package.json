    "react-dom": "^19.2.4",
    "react-router-dom": "^6.26.0",
    "scheduler": "^0.27.0",
    "three": "^0.186.1",
    "yaml": "^2.6.1",
    "zod": "^3.23.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
