# Hashed build assets are content-addressed — immutable cache for a year.
# (Server-side companion to the SW content-type guard: prevents the CDN from
#  caching a transient text/html SPA fallback under an asset URL.)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600

/sw.js
  Content-Type: text/javascript
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/icons/*
  Cache-Control: public, max-age=31536000, immutable

/.well-known/apple-app-site-association
  Content-Type: application/json

/.well-known/assetlinks.json
  Content-Type: application/json