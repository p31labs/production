/*
  P31 Portals — Security Headers
  Matches shell pattern: HSTS, nosniff, X-Frame-Options, Referrer-Policy,
  Permissions-Policy, CSP (Report-Only + Enforced), Trusted Types.
*/

/*
  Global headers — apply to all routes
*/
/* CSP allows Google Fonts for portals that use them */
Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://*.p31ca.org https://*.trimtab-signal.workers.dev; frame-ancestors 'none'; base-uri 'self'; form-action 'self';
Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://*.p31ca.org https://*.trimtab-signal.workers.dev; frame-ancestors 'none'; base-uri 'self'; form-action 'self';
Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
X-Content-Type-Options: nosniff
X-Frame-Options: DENY
Referrer-Policy: strict-origin-when-cross-origin
Permissions-Policy: bluetooth=(), camera=(), microphone=(), geolocation=(), tools=(self)
Require-Trusted-Types-For: 'script'
