{
  "name": "@p31ca/portal-shell",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run deploy:room && wrangler pages deploy dist --project-name p31-portal-shell --commit-dirty=true",
    "deploy:room": "wrangler deploy --config room/wrangler.toml",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "sync:vendor": "node /home/p31/production/tools/portal-vendor-sync/sync-vendor.mjs --target .",
    "v:gate": "node /home/p31/production/tools/portal-vendor-sync/v-gate.mjs --target .",
    "token-audit": "node scripts/token-conformance.mjs",
    "gate": "node scripts/token-conformance.mjs && tsc --noEmit && vitest run && vite build"
  },
  "dependencies": {
    "@a2ui/react": "^0.12.0",
    "@a2ui/web_core": "^0.12.0",
    "@electric-sql/pglite": "^0.5.3",
    "@p31ca/ui-forge": "file:vendor/p31-ui-forge-0.1.0.tgz",
    "@p31ca/canon": "file:vendor/p31ca-canon-0.1.0.tgz",
    "@p31ca/design-core": "file:vendor/p31-design-core-3.0.0.tgz",
    "@p31ca/sovereign-primitives": "file:vendor/p31ca-sovereign-primitives-0.0.2.tgz",
    "@tanstack/react-virtual": "^3.14.13",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-collaboration": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/y-tiptap": "^3.0.9",
    "cmdk": "^1.1.1",
    "fast-json-patch": "^3.1.1",
    "prosemirror-commands": "^1.6.2",
    "prosemirror-keymap": "^1.2.2",
    "prosemirror-model": "^1.24.1",
    "prosemirror-schema-basic": "^1.2.3",
    "prosemirror-schema-list": "^1.4.1",
    "prosemirror-state": "^1.4.3",
    "prosemirror-view": "^1.37.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-resizable-panels": "^4.14.2",
    "stream-md": "^0.2.0",
    "y-prosemirror": "^1.2.5",
    "y-protocols": "^1.0.6",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.31",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.4.3",
    "vitest": "^3.0.0",
    "wrangler": "^3.114.17"
  }
}
