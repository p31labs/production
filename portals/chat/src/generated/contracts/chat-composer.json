{
  "component": "ChatComposer",
  "system": "p31-portals/chat",
  "semantic_parts": [
    "root",
    "input",
    "actions",
    "status"
  ],
  "token_contract": {
    "surface": [
      "surface.default",
      "border.glass"
    ],
    "space": [
      "space.2",
      "space.3",
      "space.4"
    ],
    "typography": [
      "scale.sm",
      "scale.md"
    ]
  },
  "required_aria": [
    "aria-label on textarea",
    "aria-busy when streaming",
    "aria-live on status"
  ],
  "interaction_states": [
    "default",
    "focused",
    "disabled",
    "streaming"
  ],
  "spoon_contract": {
    "min_touch_target": "44px",
    "stop_button_primary": "variant=primary when generating",
    "auto_scroll": "three-state: anchored / drifted / jumped-back"
  },
  "forbidden_patterns": [
    "inline style on input",
    "emoji in actions",
    "ghost stop button during streaming"
  ]
}