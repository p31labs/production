{
  "component": "Button",
  "system": "design-core/compositions",
  "semantic_parts": ["root", "label", "icon"],
  "token_contract": {
    "color": ["color.semantic.action.primary", "color.semantic.action.primaryHover", "color.semantic.text", "color.semantic.textSecondary"],
    "space": ["space.1", "space.2", "space.3", "space.4"],
    "radius": ["radius.sm", "radius.md", "radius.full"],
    "typography": ["scale.xs", "scale.sm", "scale.md"]
  },
  "required_aria": ["aria-pressed when toggleable", "aria-disabled when disabled", "aria-label when icon-only"],
  "interaction_states": ["default", "hover", "focus-visible", "active", "disabled", "loading"],
  "spoon_contract": {
    "min_touch_target": "44px",
    "focus_ring": "required",
    "motion_reduce": "prefers-reduced-motion respected"
  },
  "forbidden_patterns": ["inline style={{}}", "hardcoded hex", "arbitrary spacing", "emoji-as-icon"]
}
