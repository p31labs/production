{
  "schema": "p31.universalCanon/2.0.0",
  "version": "2.0.0",
  "title": "P31 universal design canon — @p31ca/design-core v2.0.0 (mathematical foundation)",
  "description": "All visual values derived from PHI (1.618), Perfect Fourth (1.333), 4-multiple grid, OKLCH color space, and musical tempo (120 BPM). Single source of truth. Every surface imports from design-core. Divergence is a type error.",
  "rings": {
    "hub": {
      "hosts": ["p31ca.org", "www.p31ca.org", "*.p31ca.pages.dev", "phosphorus31.org", "www.phosphorus31.org"],
      "defaultAppearance": "hub",
      "notes": "Dark-only unified appearance. org appearance retired."
    }
  },
  "palette": {
    "comment": "DESIGN.md canonical colors — identical across all surfaces.",
    "coral": "#FB7185",
    "teal": "#34D399",
    "cyan": "#00F0FF",
    "amber": "#FBBF24",
    "lavender": "#A78BFA",
    "phosphorus": "#34D399",
    "phosphor": "#00F0FF",
    "fuchsia": "#A78BFA"
  },
  "typography": {
    "fontFamilies": {
      "sans": ["Inter", "ui-sans-serif", "system-ui", "-apple-system", "sans-serif"],
      "mono": ["JetBrains Mono", "ui-monospace", "SFMono-Regular", "Menlo", "Monaco", "Consolas", "monospace"]
    },
    "scaleRem": {
      "xs": "0.44rem",
      "sm": "0.56rem",
      "base": "1rem",
      "md": "1rem",
      "lg": "1.33rem",
      "xl": "1.78rem",
      "2xl": "2.37rem",
      "3xl": "3.16rem",
      "4xl": "3.16rem"
    },
    "lineHeight": { "tight": "1.1", "snug": "1.2", "normal": "1.6", "relaxed": "1.75" },
    "letterSpacing": { "tight": "-0.02em", "normal": "0", "wide": "0.08em", "caps": "0.12em" }
  },
  "space": {
    "px": "1px", "0": "0", "1": "0.25rem", "2": "0.5rem", "3": "0.75rem",
    "4": "1rem", "6": "1.5rem", "8": "2rem", "12": "3rem", "16": "4rem", "24": "6rem"
  },
  "radius": {
    "none": "0", "sm": "8px", "md": "12px", "lg": "24px", "xl": "24px", "2xl": "24px", "full": "9999px"
  },
  "shadow": {
    "none": "none",
    "sm": "0 1px 2px rgba(0, 0, 0, 0.06)",
    "md": "0 4px 14px rgba(0, 0, 0, 0.08)",
    "lg": "0 12px 40px rgba(0, 0, 0, 0.12)",
    "glowTeal": "0 0 24px rgba(0, 240, 255, 0.25)"
  },
  "motion": {
    "durationMs": {
      "instant": "63",
      "fast": "125",
      "normal": "250",
      "slow": "500",
      "glacial": "1000"
    },
    "easing": {
      "standard": "cubic-bezier(0.4, 0, 0.2, 1)",
      "emphasized": "cubic-bezier(0.2, 0, 0, 1)",
      "decelerate": "cubic-bezier(0, 0, 0.2, 1)"
    }
  },
  "zIndex": { "base": "0", "dropdown": "50", "sticky": "100", "overlay": "200", "modal": "300", "toast": "400" },
  "focus": {
    "ringWidth": "2px",
    "ringOffset": "2px",
    "hubRingColor": "rgba(0, 240, 255, 0.55)",
    "orgRingColor": "rgba(0, 240, 255, 0.45)"
  },
  "appearances": {
