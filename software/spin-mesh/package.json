{
  "name": "spin-mesh",
  "version": "0.1.0",
  "description": "SpIn Barter Mesh — local-first physical media swap system (K₄ extension)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "do:build": "cd matchmaking-do && npm run build",
    "do:publish": "cd matchmaking-do && npx wrangler publish",
    "schema:validate": "psql -f pglite-schema/schema.sql" 
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "tinybase": "^4.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^1.6.0",
    "wrangler": "^3.78.0"
  },
  "engines": {
    "node": ">=20"
  }
}
