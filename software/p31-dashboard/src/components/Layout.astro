---
interface Props {
  title: string;
}

const { title = 'PHOS Forge — Convergence Dashboard' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="PHOS Forge convergence dashboard — real-time telemetry, cognitive state, and deployment status." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-[#0a0a0f] text-slate-200 antialiased">
    <slot />
  </body>
</html>
