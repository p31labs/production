{
  "name": "@p31ca/music-maker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "The spatial music maker — a collaborative instrument where a family places sounds in a 3D field and hears each other play, live, across devices. Hosts the control server surface at #/control.",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/runbook-validate.mjs",
    "build": "vite build",
    "build:test": "vite build --mode test",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:deployed": "BASE_URL=https://music-presence.trimtab-signal.workers.dev playwright test",
    "smoke": "node scripts/smoke-control-room.mjs",
    "deploy": "cd worker && wrangler deploy",
    "schema:apply": "cd worker && wrangler d1 execute music-maker --remote --file=./schema.sql",
    "schema:apply:local": "cd worker && wrangler d1 execute music-maker --local --file=./schema.sql"
  },
  "dependencies": {
    "@p31ca/canon": "workspace:*",
    "@p31ca/controls": "workspace:*",
    "@p31ca/field": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.7.0",
    "vite": "^6.4.2",
    "vitest": "^3.0.0",
    "ws": "^8.18.0"
  }
}