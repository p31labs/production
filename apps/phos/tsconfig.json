{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["astro/client", "@testing-library/jest-dom"],
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", ".astro/types.d.ts"],
  "exclude": ["node_modules", "dist", ".astro", "src/workers/**"]
}
