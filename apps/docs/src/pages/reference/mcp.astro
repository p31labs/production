      <tr><td>PHOS Forge</td><td>32</td><td>Batch interface generation</td></tr>
      <tr><td>Cognitive Prosthetic</td><td>47</td><td>Temporal grounding, EF, sensory adaptation</td></tr>
      <tr><td>Cognitive Comms</td><td>20</td><td>Tone, replies, boundaries, agendas</td></tr>
      <tr><td>MARGE Design Expert</td><td>14</td><td>Design compliance audit, glass/spoons/WCAG</td></tr>
