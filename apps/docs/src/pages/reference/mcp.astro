        <th>Description</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>p31-spaceship-earth</td>
        <td><code>spaceship-relay.trimtab-signal.workers.dev/mcp</code></td>
        <td>16</td>
        <td>Dome geometry, system health, DUNA readiness, PQC ops, EUDI Wallet, session mgmt</td>
      </tr>
      <tr>
        <td>p31-crypto-mcp</td>
        <td><code>p31-crypto-mcp.trimtab-signal.workers.dev/mcp</code></td>
