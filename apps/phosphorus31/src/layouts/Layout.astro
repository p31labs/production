---
import Head from '../components/Head.astro';
import Navbar from '../components/Navbar.jsx';
import Footer from '../components/Footer.astro';
import CrisisIsland from '../components/CrisisIsland.tsx';
const { hideNav = false, ...headProps } = Astro.props;
---

<html lang="en" data-spoons="3" data-theme="quantum">
  <Head {...headProps} />
  <script>
    (function () {
      var spoons = localStorage.getItem('p31:spoons') || '3';
      var themeMap = { 0: 'crisis', 1: 'sanctuary', 2: 'sanctuary', 3: 'bridge', 4: 'quantum', 5: 'quantum' };
      document.documentElement.setAttribute('data-spoons', spoons);
      document.documentElement.setAttribute('data-theme', themeMap[spoons] || 'quantum');
    })();
  </script>
  <body class="min-h-screen flex flex-col relative selection:bg-quantum-violet selection:text-white">
    <style>
      .skip-link { position: fixed; top: -100%; left: 0; z-index: 9999; padding: 0.75rem 1.5rem; background: #0ff; color: #000; font-family: monospace; font-size: 0.875rem; font-weight: 600; text-decoration: none; border-radius: 0 0 8px 0; }
      .skip-link:focus { top: 0; }
    </style>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    {!hideNav && <Navbar client:load />}
    <div id="main-content">
      <slot />
    </div>
    <Footer />
    <CrisisIsland client:load />
  </body>
</html>
