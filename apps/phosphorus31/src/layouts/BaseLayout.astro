---
import Head from './Head.astro';
import Footer from './Footer.astro';
import Navbar from '../components/Navbar.jsx';
import '@p31ca/design-core/css/all.css';
import '../styles/overrides.css';

const { title, description } = Astro.props;
---
<html lang="en" data-spoons="3" data-theme="willow">
  <Head title={title} description={description} />
  <script>
    (function() {
      var spoons = localStorage.getItem('p31:spoons') || '3';
      var themeMap = { 0:'crisis', 1:'sanctuary', 2:'sanctuary', 3:'willow', 4:'willow', 5:'willow' };
      var theme = themeMap[spoons] || 'willow';
      document.documentElement.setAttribute('data-spoons', spoons);
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
  <body class="min-h-screen antialiased" style="background: var(--p31-bg, #070d0a); color: var(--p31-text, #f0f2f5); font-family: var(--p31-font-sans, 'Inter', system-ui, sans-serif); line-height: 1.6; -webkit-font-smoothing: antialiased; overflow-x: hidden;">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Navbar client:load />
    <div class="flex-grow" id="main-content">
      <slot />
    </div>
    <Footer />
  </body>
</html>
