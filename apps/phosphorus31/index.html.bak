            <circle cx="90" cy="72" r="4.5" fill="#FBBF24" filter="url(#hero-glow)" style="animation:vertexGlow 3s ease-in-out infinite 1.5s"/><circle cx="90" cy="72" r="2" fill="#FFFFFF"/>
