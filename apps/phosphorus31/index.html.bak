          <a href="https://ko-fi.com/trimtab69420" target="_blank" rel="noopener noreferrer" class="link-glow" style="color:var(--text-secondary);">Ko-fi</a>
          <span style="color:var(--text-tertiary);">&middot;</span>
          <a href="mailto:will@p31ca.org" class="link-glow" style="color:var(--text-secondary);">will@p31ca.org</a>
        </div>
      </div>
      <div>
        <h4 style="font-weight:700;color:var(--accent-gold);margin-bottom:1rem;">Products</h4>
        <ul class="space-y-2" style="color:var(--text-secondary);font-size:0.875rem;list-style:none;">
          <li><a href="https://p31ca.org/" target="_blank" rel="noopener noreferrer" class="link-glow" style="color:var(--text-secondary);">EDE</a></li>
          <li><a href="https://bonding.p31ca.org" target="_blank" rel="noopener noreferrer" class="link-glow" style="color:var(--text-secondary);">BONDING</a></li>
          <li><a href="#products-section" class="link-glow" style="color:var(--text-secondary);">All Products</a></li>
        </ul>
      </div>
      <div>
        <h4 style="font-weight:700;color:var(--accent-gold);margin-bottom:1rem;">Organization</h4>
        <ul class="space-y-2" style="color:var(--text-secondary);font-size:0.875rem;list-style:none;">
          <li><a href="#about" class="link-glow" style="color:var(--text-secondary);">About &amp; Mission</a></li>
          <li><a href="#research-section" class="link-glow" style="color:var(--text-secondary);">Research</a></li>
          <li><a href="https://github.com/p31labs" target="_blank" rel="noopener noreferrer" class="link-glow" style="color:var(--text-secondary);">Source Code</a></li>
        </ul>
      </div>
    </div>
    <div style="max-width:72rem;margin:0 auto;padding:3rem 1.5rem 0;margin-top:3rem;border-top:1px solid rgba(255,255,255,0.1);font-size:0.75rem;color:var(--text-tertiary);display:flex;flex-direction:column;gap:1rem;">
      <div>&copy; 2026 P31 Labs, Inc. &middot; Georgia Nonprofit &middot; 501(c)(3) pending</div>
      <div>Open Source under MIT License. No tracking. No ads.</div>
    </div>
  </footer>

  <div class="spoon-meter">
    <span>Spoons:</span>
    <div class="spoon-track" id="spoon-track">
      <div class="spoon-dot" data-level="0"></div>
      <div class="spoon-dot" data-level="1"></div>
      <div class="spoon-dot" data-level="2"></div>
      <div class="spoon-dot filled" data-level="3"></div>
      <div class="spoon-dot" data-level="4"></div>
      <div class="spoon-dot" data-level="5"></div>
    </div>
    <span id="spoon-label">3/5</span>
  </div>

  <script>
(function() {
  var html = document.documentElement;
  var spoons = parseInt(localStorage.getItem('p31:spoons') || '3');
  var theme = localStorage.getItem('p31:theme') || 'dark';
  html.setAttribute('data-spoons', spoons);
  html.setAttribute('data-theme', theme);

  function updateSpoonsUI(level) {
    var dots = document.querySelectorAll('.spoon-dot');
    dots.forEach(function(d, i) { d.classList.toggle('filled', i <= level); });
    var label = document.getElementById('spoon-label');
    if (label) label.textContent = level + '/5';
  }

  function setSpoons(level) {
    spoons = level;
    html.setAttribute('data-spoons', level);
    localStorage.setItem('p31:spoons', level);
    updateSpoonsUI(level);
  }

  document.getElementById('spoon-track').addEventListener('click', function(e) {
    var dot = e.target.closest('.spoon-dot');
    if (dot) setSpoons(parseInt(dot.dataset.level));
  });

  updateSpoonsUI(spoons);

  var toggleBtn = document.getElementById('theme-toggle');
  function updateToggleIcon() {
    toggleBtn.innerHTML = html.getAttribute('data-theme') === 'light' ? '\u2600\uFE0F' : '\uD83C\uDF19';
    document.querySelector('meta[name="theme-color"]').setAttribute('content',
      html.getAttribute('data-theme') === 'light' ? '#F8FAFC' : '#0A0A0F');
  }
  updateToggleIcon();

  toggleBtn.addEventListener('click', function() {
    var newTheme = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    html.setAttribute('data-theme', newTheme);
    localStorage.setItem('p31:theme', newTheme);
    updateToggleIcon();
  });

  // ROUTER
  var pages = {
    '/': 'page-index',
    '/about': 'page-about',
    '/impact': 'page-impact',
    '/products': 'page-products',
    '/research': 'page-research',
    '/blog': 'page-blog',
    '/get-involved': 'page-get-involved',
    '/quantum': 'page-quantum',
    '/care': 'page-care'
  };

  function route(path) {
    var active = document.querySelector('.page.active');
    if (active) active.classList.remove('active');
    var targetId = pages[path] || 'page-index';
    var target = document.getElementById(targetId);
    if (target) target.classList.add('active');
    document.querySelectorAll('[data-route]').forEach(function(a) {
      a.classList.toggle('active', a.getAttribute('data-route') === path);
    });
    window.scrollTo({ top: 0, behavior: 'instant' });
  }

  document.body.addEventListener('click', function(e) {
    var link = e.target.closest('[data-route]');
    if (!link) return;
    e.preventDefault();
    var path = link.getAttribute('data-route');
    if (path === window.location.pathname) return;
    history.pushState(null, '', path);
    route(path);
  });

  window.addEventListener('popstate', function() {
    route(window.location.pathname);
  });

  var currentPath = window.location.pathname;
  if (currentPath !== '/' && pages[currentPath]) {
    var activeEl = document.querySelector('.page.active');
    if (activeEl) activeEl.classList.remove('active');
    var targetEl = document.getElementById(pages[currentPath]);
    if (targetEl) targetEl.classList.add('active');
  }
  document.querySelectorAll('[data-route]').forEach(function(a) {
    if (a.getAttribute('data-route') === currentPath) a.classList.add('active');
  });

  // STARFIELD
  (function() {
    var canvas = document.getElementById('starfield');
    if (!canvas) return;
    var ctx = canvas.getContext('2d');
    var stars = [];
    var count = 200;
    var STAR_SPEED = 0.08;

    function resize() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    resize();
    window.addEventListener('resize', resize);

    for (var i = 0; i < count; i++) {
      stars.push({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height,
        r: Math.random() * 1.8 + 0.3,
        a: Math.random(),
        twinkleSpeed: Math.random() * 0.02 + 0.005,
        twinkleDir: Math.random() < 0.5 ? 1 : -1
      });
    }

    function draw() {
      if (parseInt(html.getAttribute('data-spoons')) <= 1) {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        requestAnimationFrame(draw);
        return;
      }
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      for (var i = 0; i < stars.length; i++) {
        var s = stars[i];
        s.a += s.twinkleSpeed * s.twinkleDir;
        if (s.a >= 1) { s.a = 1; s.twinkleDir = -1; }
        if (s.a <= 0.2) { s.a = 0.2; s.twinkleDir = 1; }
        var alpha = s.a * 0.7;
        ctx.beginPath();
        ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(255,255,255,' + alpha + ')';
        ctx.fill();
        s.y += STAR_SPEED * (s.r * 0.5 + 0.3);
        if (s.y > canvas.height + 10) { s.y = -10; s.x = Math.random() * canvas.width; }
      }
      requestAnimationFrame(draw);
    }
    draw();
  })();
})();
  </script>
</body>
</html>
