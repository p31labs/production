                <a href="https://ko-fi.com/trimtab69420" target="_blank" rel="noopener noreferrer" class="btn-ghost" style="font-size:0.75rem;flex:1;text-align:center;justify-content:center;">LOVE</a>
                <a href="https://ko-fi.com/trimtab69420" target="_blank" rel="noopener noreferrer" class="btn-ghost" style="font-size:0.75rem;flex:1;text-align:center;justify-content:center;">USDC</a>
              </div>
            </div>
            <div class="glass-card" style="display:flex;flex-direction:column;">
              <div style="width:40px;height:40px;border-radius:var(--radius-lg);background:rgba(251,191,36,0.1);display:flex;align-items:center;justify-content:center;margin-bottom:1rem;"><svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" style="color:var(--accent-gold);"><path d="M10.362 1.093a.75.75 0 00-.724 0L2.523 5.018 10 9.143l7.477-4.125-7.115-3.925zM18 6.443l-7.25 4v8.25l6.862-3.786A.75.75 0 0018 14.25V6.443zm-8.75 12.25v-8.25l-7.25-4v7.807a.75.75 0 00.388.657l6.862 3.786z"/></svg></div>
              <h3 style="color:var(--text);font-weight:700;font-size:1rem;margin-bottom:0.25rem;">Volunteer</h3>
              <p style="color:var(--text-secondary);font-size:0.75rem;flex:1;margin-bottom:1rem;">Contribute code, design, research, or advocacy. All skills welcome.</p>
              <a href="https://github.com/p31labs" target="_blank" rel="noopener noreferrer" class="btn-secondary" style="font-size:0.75rem;text-align:center;justify-content:center;">Get Started</a>
            </div>
            <div class="glass-card" style="display:flex;flex-direction:column;">
              <div style="width:40px;height:40px;border-radius:var(--radius-lg);background:rgba(52,211,153,0.1);display:flex;align-items:center;justify-content:center;margin-bottom:1rem;"><svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" style="color:var(--accent-green);"><path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18v-3a5.972 5.972 0 00-.75-2.906A3.005 3.005 0 0119 15v3h-3zM4.75 12.094A5.973 5.973 0 004 15v3H1v-3a3 3 0 013.75-2.906z"/></svg></div>
              <h3 style="color:var(--text);font-weight:700;font-size:1rem;margin-bottom:0.25rem;">Partner</h3>
              <p style="color:var(--text-secondary);font-size:0.75rem;flex:1;margin-bottom:1rem;">Research institutions, care organizations, and grant partners.</p>
