      <section id="get-involved-section" class="section">
        <div class="container px-6">
          <h2 class="section-title">Get Involved</h2>
          <p class="section-desc">Every contribution matters. Join us in building sovereign care technology.</p>
          <div class="grid-4 mb-16">
            <div class="glass-card" style="display:flex;flex-direction:column;">
              <div style="width:40px;height:40px;border-radius:var(--radius-lg);background:rgba(0,240,255,0.1);display:flex;align-items:center;justify-content:center;margin-bottom:1rem;"><svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" style="color:var(--accent);"><path d="M10 1a6 6 0 00-3.815 10.631C7.237 12.5 8 13.443 8 14.456v.644a.75.75 0 00.572.729 6.016 6.016 0 002.856 0A.75.75 0 0012 15.1v-.644c0-1.013.763-1.957 1.815-2.825A6 6 0 0010 1zM8.863 17.414a.75.75 0 00-.226 1.483 9.066 9.066 0 002.726 0 .75.75 0 00-.226-1.483 7.553 7.553 0 01-2.274 0z"/></svg></div>
              <h3 style="color:var(--text);font-weight:700;font-size:1rem;margin-bottom:0.25rem;">Join Pilot</h3>
              <p style="color:var(--text-secondary);font-size:0.75rem;flex:1;margin-bottom:1rem;">Be among the first families to use P31 tools. Shape the roadmap with your feedback.</p>
              <a href="https://phos.p31ca.org/portal" target="_blank" rel="noopener noreferrer" class="btn-primary" style="font-size:0.75rem;text-align:center;justify-content:center;">Apply Now</a>
            </div>
            <div class="glass-card" style="display:flex;flex-direction:column;">
              <div style="width:40px;height:40px;border-radius:var(--radius-lg);background:rgba(167,139,250,0.1);display:flex;align-items:center;justify-content:center;margin-bottom:1rem;"><svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" style="color:var(--accent-violet);"><path d="M9.653 16.915l-.005-.003-.019-.01a20.759 20.759 0 01-1.587-1.058c-.79-.6-1.823-1.488-2.774-2.66C3.93 11.563 3 9.7 3 7.5 3 4.462 5.462 2 8.5 2c1.423 0 2.742.523 3.746 1.43C13.25 2.523 14.577 2 16 2 19.038 2 21.5 4.462 21.5 7.5c0 2.2-.93 4.063-2.293 5.687-.95 1.172-1.984 2.059-2.774 2.66a20.679 20.679 0 01-1.587 1.058l-.019.01-.005.003-.002.001c-.238.128-.516.179-.82.179s-.582-.051-.82-.179z"/></svg></div>
              <h3 style="color:var(--text);font-weight:700;font-size:1rem;margin-bottom:0.25rem;">Donate</h3>
              <p style="color:var(--text-secondary);font-size:0.75rem;flex:1;margin-bottom:1rem;">Support free assistive technology with LOVE care-credits or USDC. Every donation goes directly to building tools.</p>
