<body>
  <a href="#main-content" class="skip-link">Skip to main content</a>
  <canvas id="starfield" aria-hidden="true"></canvas>
  <nav class="top-nav glass-strong" role="navigation" aria-label="Main navigation">
    <a href="/" class="logo">P31 Labs</a>
    <div class="nav-links">
      <a data-route="/">Home</a>
      <a data-route="/about">About</a>
      <a data-route="/impact">Impact</a>
      <a data-route="/products">Products</a>
      <a data-route="/research">Research</a>
      <a data-route="/blog">Blog</a>
      <a data-route="/get-involved">Get Involved</a>
    </div>
    <button id="theme-toggle" aria-label="Toggle theme" title="Toggle theme">🌙</button>
  </nav>
  <nav class="tetra-nav" role="navigation" aria-label="Tetrahedral navigation">
    <a data-route="/quantum">◈ Quantum</a>
    <a data-route="/care">◈ Care</a>
    <a data-route="/research">◈ Research</a>
    <a data-route="/impact">◈ Impact</a>
  </nav>
  <main id="main-content">
    <section id="page-index" class="page active">
      <div class="space-y-6" style="max-width:80rem;margin:0 auto;padding:1rem 1.5rem 0;">
        <div class="tetra-grid">
          <a data-route="/quantum" class="glass-card p-6 rounded-xl" style="text-decoration:none;display:block;">
            <div style="font-size:10px;font-family:var(--font-mono);color:var(--accent);letter-spacing:0.1em;">V&#x2081; &middot; |&#x3C8;&#x2081;&rang;</div>
            <h3 style="font-size:18px;font-weight:700;color:var(--text);">Quantum Core</h3>
            <p style="font-size:12px;color:var(--text-tertiary);">SIC-POVM d=2 &middot; K&#x2084; Topology &middot; Posner Molecule</p>
            <div style="font-size:10px;font-family:var(--font-mono);color:var(--text-tertiary);margin-top:8px;">overlap = 1/3 &middot; V=4 &middot; E=6 &middot; rigid &#x2713;</div>
          </a>
          <a data-route="/care" class="glass-card p-6 rounded-xl" style="text-decoration:none;display:block;">
            <div style="font-size:10px;font-family:var(--font-mono);color:var(--accent-violet);letter-spacing:0.1em;">V&#x2082; &middot; |&#x3C8;&#x2082;&rang;</div>
            <h3 style="font-size:18px;font-weight:700;color:var(--text);">Care Economy</h3>
            <p style="font-size:12px;color:var(--text-tertiary);">LOVE Ledger &middot; Care Mesh &middot; Spoon-Aware</p>
            <div style="font-size:10px;font-family:var(--font-mono);color:var(--text-tertiary);margin-top:8px;">non-extractive &middot; court-admissible &middot; &#x3B5;=0.5 DP</div>
          </a>
          <a data-route="/research" class="glass-card p-6 rounded-xl" style="text-decoration:none;display:block;">
            <div style="font-size:10px;font-family:var(--font-mono);color:var(--accent-gold);letter-spacing:0.1em;">V&#x2083; &middot; |&#x3C8;&#x2083;&rang;</div>
            <h3 style="font-size:18px;font-weight:700;color:var(--text);">Research</h3>
            <p style="font-size:12px;color:var(--text-tertiary);">22 Papers &middot; 3 Grants &middot; eIDAS Alignment</p>
            <div style="font-size:10px;font-family:var(--font-mono);color:var(--text-tertiary);margin-top:8px;">Zenodo &middot; Open Access &middot; ORCID 0009-0002-2492-9079</div>
          </a>
          <a data-route="/impact" class="glass-card p-6 rounded-xl" style="text-decoration:none;display:block;">
            <div style="font-size:10px;font-family:var(--font-mono);color:var(--accent-green);letter-spacing:0.1em;">V&#x2084; &middot; |&#x3C8;&#x2084;&rang;</div>
            <h3 style="font-size:18px;font-weight:700;color:var(--text);">Impact</h3>
            <p style="font-size:12px;color:var(--text-tertiary);">18 Pilots &middot; 1,247 LOVE &middot; 14 Workers</p>
            <div style="font-size:10px;font-family:var(--font-mono);color:var(--text-tertiary);margin-top:8px;">tetrahedral &middot; isostatic &middot; sovereign</div>
          </a>
        </div>
        <div class="glass-panel p-6 md:p-8 rounded-2xl">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
            <div style="font-size:12px;font-family:var(--font-mono);color:var(--text-tertiary);letter-spacing:0.1em;">SIC-POVM MEASUREMENT &middot; d=2 &middot; 4 STATES</div>
            <div style="font-size:10px;font-family:var(--font-mono);color:var(--text-tertiary);">overlap = 1/3 &middot; Tr(&#x3C1;&#x3A0;&#x1D62;)</div>
          </div>
          <div style="height:120px;display:flex;align-items:center;justify-content:center;background:var(--glass-bg);border-radius:var(--radius-lg);border:1px solid var(--glass-border);">
            <span style="font-family:var(--font-mono);font-size:11px;color:var(--text-tertiary);">SIC-POVM Gauge &mdash; load modularly for live measurement</span>
          </div>
        </div>
        <div class="glass-panel p-6 md:p-8 rounded-2xl">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
            <div style="font-size:12px;font-family:var(--font-mono);color:var(--text-tertiary);letter-spacing:0.1em;">K&#x2084; COMPLETE GRAPH TOPOLOGY</div>
            <div style="font-size:10px;font-family:var(--font-mono);color:var(--text-tertiary);">V=4 &middot; E=6 &middot; Planar &middot; &#x3B2;&#x2082;=1</div>
          </div>
          <div style="height:200px;display:flex;align-items:center;justify-content:center;background:var(--glass-bg);border-radius:var(--radius-lg);border:1px solid var(--glass-border);">
            <span style="font-family:var(--font-mono);font-size:11px;color:var(--text-tertiary);">&#x2726; K&#x2084; Complete Graph &mdash; Isostatically Rigid (E = 3V &minus; 6 = 6) &middot; 863 Hz</span>
          </div>
        </div>
        <div class="glass-panel p-6 rounded-2xl text-center">
          <div style="display:inline-block;padding:4px 16px;border-radius:20px;border:1px solid rgba(0,240,255,0.15);">
            <span style="font-size:24px;font-weight:800;background:linear-gradient(135deg,#00F0FF,#A78BFA,#34D399);-webkit-background-clip:text;background-clip:text;color:transparent;">863 Hz</span>
            <span style="font-size:12px;font-family:var(--font-mono);color:var(--text-tertiary);margin-left:8px;">Larmor Somatic Regulation</span>
          </div>
          <div style="margin-top:8px;font-size:10px;font-family:var(--font-mono);color:var(--text-tertiary);">K&#x2084; is planar &middot; &#x3B2;&#x2082; = 1 &middot; The cage holds</div>
        </div>
        <div class="honest-label">
          &#x26A0;&#xFE0F; HONEST LABEL: This site implements a computational model inspired by contested hypotheses.
          The underlying science is NOT established physics or accepted medical science.
          This code is an architectural metaphor made literal &mdash; a sovereign care measurement primitive.
