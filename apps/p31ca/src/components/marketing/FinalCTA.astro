---
/**
 * FinalCTA — the one action, repeated at the bottom (dev-tool conversion).
 */
interface Props {
  headline: string;
  href: string;
  label: string;
}
const { headline, href, label } = Astro.props;
---

<section class="pb-16">
  <div class="rounded-2xl border p-10 text-center" style="border-color: var(--p31-glass-border); background: var(--p31-surface);">
    <h2 class="text-2xl md:text-3xl font-semibold mb-4" style="font-family: var(--p31-font-serif, Georgia, serif); font-weight: 400; color: var(--p31-text);">
      {headline}
    </h2>
    <a href={href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-8 py-3 rounded-lg font-semibold no-underline" style="background: var(--p31-accent); color: var(--p31-bg, #141413);">
      {label} →
    </a>
  </div>
</section>