---
/**
 * LiveProofPanel — the green-dot live proof that makes "it's real" felt.
 * Shows a live URL with a status dot and one-line status. No invented metrics.
 */
interface Props {
  urls: { label: string; href: string }[];
  statusLine?: string;
}
const { urls, statusLine = 'Live in production' } = Astro.props;
---

<div class="lp-rounded-2xl lp-border lp-p-5" style="border-color: var(--p31-glass-border); background: var(--p31-surface);">
  <div class="lp-flex lp-items-center lp-gap-2 lp-mb-3">
    <span class="lp-w-2 lp-h-2 lp-rounded-full" style="background: var(--p31-chain-verified, #788c5d); box-shadow: 0 0 6px rgba(120,140,93,0.6);" aria-hidden="true"></span>
    <span class="lp-text-sm lp-font-semibold" style="color: var(--p31-text);">{statusLine}</span>
  </div>
  <ul class="lp-space-y-2 lp-text-sm">
    {urls.map((u) => (
      <li>
        <a href={u.href} target="_blank" rel="noopener noreferrer" style="color: var(--p31-accent); text-decoration: none; word-break: break-all;">
          {u.label}
        </a>
      </li>
    ))}
  </ul>
</div>