---
/**
 * LiveProofPanel — the green-dot live proof that makes "it's real" felt.
 * Shows a live URL with a status dot and one-line status. No invented metrics.
 */
interface Props {
  urls: { label: string; href: string }[];
  statusLine?: string;
}
const { urls, statusLine = 'Live in production' } = Astro.props;
---

<div class="rounded-2xl border p-5" style="border-color: var(--p31-glass-border); background: var(--p31-surface);">
  <div class="flex items-center gap-2 mb-3">
    <span class="w-2 h-2 rounded-full" style="background: var(--p31-chain-verified, #788c5d); box-shadow: 0 0 6px rgba(120,140,93,0.6);" aria-hidden="true"></span>
    <span class="text-sm font-semibold" style="color: var(--p31-text);">{statusLine}</span>
  </div>
  <ul class="space-y-2 text-sm">
    {urls.map((u) => (
      <li>
        <a href={u.href} target="_blank" rel="noopener noreferrer" style="color: var(--p31-accent); text-decoration: none; word-break: break-all;">
          {u.label}
        </a>
      </li>
    ))}
  </ul>
</div>