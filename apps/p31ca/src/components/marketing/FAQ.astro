---
/**
 * FAQ — answers the objections before they're asked (dev-tool conversion
 * pattern). Renders as <details>/<summary> accordions.
 */
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

<section class="mb-20">
  <div class="max-w-3xl mx-auto">
    <h2 class="text-2xl mb-6" style="font-family: var(--p31-font-serif, Georgia, serif); font-weight: 400; color: var(--p31-text);">Questions people ask</h2>
    <div class="space-y-3">
      {items.map((item) => (
        <details class="rounded-xl border px-5 py-4" style="border-color: var(--p31-glass-border); background: var(--p31-surface);">
          <summary class="text-sm font-semibold cursor-pointer" style="color: var(--p31-text);">{item.q}</summary>
          <p class="mt-3 text-sm leading-relaxed" style="color: var(--p31-text-secondary);">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>