---
/**
 * FAQ — answers the objections before they're asked (dev-tool conversion
 * pattern). Renders as <details>/<summary> accordions.
 * Unified with the about/team rhythm (p31ca-unification-badge-2026-10-13):
 * full container width, start-aligned sans-bold h2. Spacing comes from the
 * FlagshipPage section wrapper — no per-section bottom margin here.
 */
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

<section>
  <h2 class="fa-text-2xl fa-font-bold fa-mb-6" style="color: var(--p31-text);">Questions people ask</h2>
  <div class="fa-space-y-3">
    {items.map((item) => (
      <details class="fa-rounded-xl fa-border fa-px-5 fa-py-4" style="border-color: var(--p31-glass-border); background: var(--p31-surface);">
        <summary class="fa-text-sm fa-font-semibold fa-cursor-pointer" style="color: var(--p31-text);">{item.q}</summary>
        <p class="fa-mt-3 fa-text-sm fa-leading-relaxed" style="color: var(--p31-text-secondary);">{item.a}</p>
      </details>
    ))}
  </div>
</section>