---
interface Props {
  name: string;
}
const { name } = Astro.props;
const initial = name.trim().charAt(0).toUpperCase();
---

<div
  class="av-flex av-h-14 av-w-14 av-items-center av-justify-center av-rounded-full av-text-lg av-font-bold"
  style="background: color-mix(in oklch, var(--p31-accent) 18%, transparent); color: var(--p31-accent); border: 1px solid var(--p31-glass-border, rgba(255,255,255,0.16));"
  aria-hidden="true"
>
  {initial}
</div>