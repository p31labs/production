---
/**
 * ResearchCard — one verified paper.
 *
 * Matches the Paper shape in src/data/p31-research.ts. The DOI renders as a
 * canonical https://doi.org/<doi-name> resolver link (APA 7th format — full
 * URL, no "DOI:" label).
 */
interface Props {
  id: string;
  title: string;
  series: string;
  doi: string;
  links: { html: string };
  date: string;
  description: string;
}

const { title, series, doi, links, date } = Astro.props;

const resolverUrl = links?.html || `https://doi.org/${doi}`;
const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
});
---

<article class="glass-card rc-p-6 rc-rounded-xl rc-flex rc-flex-col rc-gap-3">
  <span class="rc-font-mono rc-text-xs rc-tracking-wider rc-uppercase" style="color: var(--p31-accent);">
    {series}
  </span>
  <h3 class="rc-text-base rc-font-bold rc-leading-snug" style="color: var(--p31-text);">
    {title}
  </h3>
  <div class="rc-flex rc-items-center rc-justify-between rc-gap-2 rc-mt-auto rc-pt-3" style="border-top: 1px solid var(--p31-glass-border, rgba(255,255,255,0.08));">
    <a
      href={resolverUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="underline-draw rc-font-mono rc-text-xs rc-truncate"
      style="color: var(--p31-text-secondary);"
      title={`DOI: ${doi}`}
    >
      {doi} ↗
    </a>
    <span class="rc-font-mono rc-text-xs rc-shrink-0" style="color: var(--p31-text-tertiary, #a1a1a1);">
      {formattedDate}
    </span>
  </div>
</article>