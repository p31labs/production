---
interface Props {
  title?: string;
  children?: any;
  class?: string;
  style?: string;
}

const { title, children, class: className = '', style = '' } = Astro.props;
---

<div class={`glass-card${className}`} style={`background: var(--p31-glass-bg); border: 1px solid var(--p31-glass-border); backdrop-filter: var(--p31-glass-blur); -webkit-backdrop-filter: var(--p31-glass-blur); border-radius: var(--p31-radius-xl); box-shadow: var(--p31-glass-shadow); ${style}`}>
  {title && (
    <div class="gc-px-6 gc-py-4" style="border-bottom: 1px solid var(--p31-glass-border);">
      <h3 class="gc-text-sm gc-font-semibold gc-tracking-wide gc-uppercase" style="color: var(--p31-text);">{title}</h3>
    </div>
  )}
  <div class="gc-p-6">
    {children}
  </div>
</div>
