---
/**
 * FlagshipPage — the unified flagship template (all 8 /apps/* surfaces).
 * Structure (about/team look, per p31ca-unification-badge-2026-10-13):
 * SectionHeader (start-aligned, same rhythm as /about /team) → primary CTA
 * row → explorable artifact → specifics → stack → FAQ → final CTA.
 * Container max-w-4xl — the same width as /about and /team (no wider pages).
 * The "Live in production" proof panel (LiveProofPanel) was removed
 * 2026-10-13 — see docs/fix-plans/p31ca-unification-badge-2026-10-13.md.
 * No invented metrics.
 */
import MarketingShell from '../../layouts/MarketingShell.astro';
import SectionHeader from '../../components/marketing/SectionHeader.astro';
import FAQ from '../../components/marketing/FAQ.astro';
import FinalCTA from '../../components/marketing/FinalCTA.astro';
import Footer from '../../components/marketing/Footer.astro';
import ExplorableChain from '../../components/islands/ExplorableChain.tsx';
import LumiTokenVisualizer from '../../components/islands/LumiTokenVisualizer.tsx';
import GovernanceGallery from '../../components/islands/GovernanceGallery.tsx';
import ModeGateDemo from '../../components/islands/ModeGateDemo.tsx';
import TerminalDemo from '../../components/islands/TerminalDemo.tsx';
import MCPRegistryQuery from '../../components/islands/MCPRegistryQuery.tsx';
import SpaceshipDome from '../../components/islands/SpaceshipDome.tsx';
import MeatspaceMesh from '../../components/islands/MeatspaceMesh.tsx';
import type { Flagship } from '../../data/flagships';

interface Props {
  flagship: Flagship;
}

const { flagship: f } = Astro.props;

// ── JSON-LD (void-fill item 6): SoftwareApplication for every /apps/* surface.
const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: f.name,
  url: f.url,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Web',
  description: f.lede,
  provider: { '@type': 'Organization', name: 'P31 Labs', url: 'https://p31ca.org' },
};
---

<MarketingShell
  title={`${f.name} — P31 Labs`}
  description={`${f.name}: ${f.tagline}. ${f.lede}`}
  theme="cipher"
  background="dome"
>
  <main id="main-content" class="section">
    <script type="application/ld+json" set:html={JSON.stringify(softwareJsonLd)} />
    <div class="fp-max-w-4xl fp-mx-auto fp-px-6 fp-md-px-12 fp-lg-px-16">

      {/* ── PAGE HEADER: the same SectionHeader chain as /about and /team ── */}
      <SectionHeader
        level="1"
        title={f.name}
        description={f.lede}
        align="left"
      />

      {/* ── PRIMARY ACTIONS: same CTA row recipe as /about's CTA section ── */}
      <div class="fp-mt-6 fp-flex fp-flex-wrap fp-gap-4">
        <a href={f.url} target="_blank" rel="noopener noreferrer" class="fp-inline-flex fp-items-center fp-gap-2 fp-rounded-full fp-px-6 fp-py-3 fp-text-sm fp-font-semibold fp-no-underline" style="background: var(--p31-accent); color: var(--p31-bg, #141413);">
          {f.ctaLabel} →
        </a>
        <a href="#explore" class="fp-inline-flex fp-items-center fp-gap-2 fp-rounded-full fp-px-6 fp-py-3 fp-text-sm fp-font-semibold fp-border fp-no-underline" style="border-color: var(--p31-glass-border); color: var(--p31-text);">
          See it work ↓
        </a>
      </div>

      <div class="fp-mt-16 fp-space-y-8">

        {/* ── THE EXPLORABLE ARTIFACT (the transducer) ── */}
        <section id="explore">
          <h2 class="fp-text-2xl fp-font-bold fp-mb-3" style="color: var(--p31-text);">
            What "{f.name.toLowerCase()}" actually means
          </h2>
          <p class="fp-mb-8" style="color: var(--p31-text-secondary);">
            Try it. {f.artifactPrompt}
          </p>
          {f.artifact === 'chain' && <ExplorableChain client:load />}
          {f.artifact === 'token' && <LumiTokenVisualizer client:load />}
          {f.artifact === 'gallery' && <GovernanceGallery client:load />}
          {f.artifact === 'modegate' && <ModeGateDemo client:load />}
          {f.artifact === 'terminal' && <TerminalDemo client:load />}
          {f.artifact === 'registry' && <MCPRegistryQuery client:load />}
          {f.artifact === 'dome' && <SpaceshipDome client:load />}
          {f.artifact === 'mesh' && <MeatspaceMesh client:load />}
        </section>

        {/* ── WHAT'S INSIDE (specifics, not outcomes) ── */}
        <section>
          <h2 class="fp-text-2xl fp-font-bold fp-mb-6" style="color: var(--p31-text);">What's inside</h2>
          <div data-p31="grid" data-cols="2" data-even class="fp-gap-4">
            {f.capabilities.map((c) => (
              <div class="fp-rounded-xl fp-border fp-p-5" style="border-color: var(--p31-glass-border); background: var(--p31-surface);">
                <h3 class="fp-text-base fp-font-semibold fp-mb-2" style="color: var(--p31-text);">{c.title}</h3>
                <p class="fp-text-sm fp-leading-relaxed" style="color: var(--p31-text-secondary);">{c.desc}</p>
              </div>
            ))}
          </div>
        </section>

        {/* ── STACK ── */}
        <section>
          <h2 class="fp-text-2xl fp-font-bold fp-mb-4" style="color: var(--p31-text);">Built with</h2>
          <div class="fp-flex fp-flex-wrap fp-gap-2">
            {f.stack.map((s) => (
              <span class="fp-px-3 fp-py-1-5 fp-rounded-full fp-text-xs fp-font-mono fp-border" style="border-color: var(--p31-glass-border); color: var(--p31-text-secondary);">{s}</span>
            ))}
          </div>
        </section>

        {/* ── FAQ (objections answered before asked) ── */}
        <FAQ items={f.faq} />

        {/* ── FINAL CTA ── */}
        <FinalCTA headline={`Try ${f.name} now.`} href={f.url} label={f.ctaLabel} />

      </div>
    </div>
  </main>

  <Footer />
</MarketingShell>