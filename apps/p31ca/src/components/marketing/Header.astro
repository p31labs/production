---
const navItems = [
  { href: '/', label: 'Hub' },
  { href: '/research', label: 'Research' },
  { href: '/arcade', label: 'Arcade' },
  { href: '/get-involved', label: 'Get Involved' },
  { href: '/signin', label: 'Sign In' },
];
---

<header class="hd-fixed hd-top-0 hd-left-0 hd-right-0 hd-z-50" style="background: rgba(3, 7, 14, 0.85); backdrop-filter: blur(12px); border-bottom: 1px solid var(--p31-glass-border);">
  <div class="hd-max-w-7xl hd-mx-auto hd-px-6 hd-md-px-12 hd-lg-px-16">
    <div class="hd-flex hd-items-center hd-justify-between hd-h-14">
      <a href="/" class="hd-flex hd-items-center hd-gap-3 group">
        <div class="hd-w-8 hd-h-8 hd-rounded-lg hd-flex hd-items-center hd-justify-center" style="background: var(--p31-accent); color: #000; font-weight: 800; font-size: 14px;">P31</div>
        <span class="hd-font-semibold hd-text-sm hd-tracking-tight hd-hidden hd-sm-inline" style="color: var(--p31-text);">Labs</span>
      </a>
      <nav class="hd-hidden hd-md-flex hd-items-center hd-gap-1" aria-label="Main navigation">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="hd-px-3 hd-py-1-5 hd-text-sm hd-rounded-md hd-transition-colors"
            style="color: var(--p31-text-secondary);"
          >
            {item.label}
          </a>
        ))}
      </nav>
      <div class="hd-flex hd-items-center hd-gap-3">
        <a href="/signin" class="hd-text-sm hd-font-medium hd-px-4 hd-py-2 hd-rounded-lg hd-transition-colors" style="background: var(--p31-accent); color: #000;">
          Sign In
        </a>
      </div>
    </div>
  </div>
</header>
