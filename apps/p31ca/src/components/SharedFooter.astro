        <a href="/accessibility" class="sf-hover-text-white-90 sf-transition-colors sf-no-underline">Accessibility</a>
        <a href="/terms" class="sf-hover-text-white-90 sf-transition-colors sf-no-underline">Terms</a>
        <a href="/security" class="sf-hover-text-white-90 sf-transition-colors sf-no-underline">Security</a>
