---
import MarketingShell from '../layouts/MarketingShell.astro';

import Footer from '../components/marketing/Footer.astro';
import '@p31ca/canon/tokens.css';
import '@p31ca/canon-react/styles.css';
import { Button } from '@p31ca/canon-react';
---

<MarketingShell theme="sunlight" title="Sign Up — P31 Labs" description="Create your P31 Labs account. Email/password or DID:key.">
  <main id="main-content" class="section flex items-center justify-center">
    <div class="w-full max-w-md px-6 md:px-12 lg:px-16">
      <div class="glass-card animate-scale-in p-8 space-y-6">
        <div class="text-center space-y-2">
          <h1 class="text-2xl font-bold" style="color: var(--p31-text);">Sign Up</h1>
          <p class="text-sm" style="color: var(--p31-text-secondary);">Create your sovereign P31 account</p>
        </div>
        
        <form class="space-y-4" onsubmit="alert('Auth backend not wired yet. Deploy apps/auth/ first.'); return false;">
          <div class="space-y-2">
            <label for="email" class="text-sm font-medium" style="color: var(--p31-text);">Email</label>
            <input type="email" id="email" name="email" required class="w-full px-4 py-3 rounded-lg text-sm transition-all" style="background: rgba(255,255,255,0.03); border: 1px solid var(--p31-glass-border); color: var(--p31-text); outline: none;" onfocus="this.style.borderColor='var(--p31-accent)'" onblur="this.style.borderColor='var(--p31-glass-border)'" />
          </div>
          <div class="space-y-2">
            <label for="password" class="text-sm font-medium" style="color: var(--p31-text);">Password</label>
            <input type="password" id="password" name="password" required class="w-full px-4 py-3 rounded-lg text-sm transition-all" style="background: rgba(255,255,255,0.03); border: 1px solid var(--p31-glass-border); color: var(--p31-text); outline: none;" onfocus="this.style.borderColor='var(--p31-accent)'" onblur="this.style.borderColor='var(--p31-glass-border)'" />
          </div>
          <div class="space-y-2">
            <label for="confirm-password" class="text-sm font-medium" style="color: var(--p31-text);">Confirm Password</label>
            <input type="password" id="confirm-password" name="confirm-password" required class="w-full px-4 py-3 rounded-lg text-sm transition-all" style="background: rgba(255,255,255,0.03); border: 1px solid var(--p31-glass-border); color: var(--p31-text); outline: none;" onfocus="this.style.borderColor='var(--p31-accent)'" onblur="this.style.borderColor='var(--p31-glass-border)'" />
          </div>
          <Button client:load variant="primary" type="submit" className="w-full">Create Account</Button>
        </form>
        
        <div class="relative py-4" style="border-top: 1px solid var(--p31-glass-border);">
          <span class="absolute top-1/2 left-1/2 text-xs px-2" style="background: var(--p31-bg); color: var(--p31-text-tertiary); translate: -50% -50%;">or</span>
        </div>
        
        <div class="space-y-3">
          <button onclick="alert('DID:key auth requires production shell deployment.')" class="btn btn-secondary w-full justify-center">
            <span style="font-family: var(--p31-font-mono);">🔑</span>
            <span>Sign Up with DID:key</span>
          </button>
        </div>
        
        <p class="text-xs text-center" style="color: var(--p31-text-tertiary);">
          Already have an account? <a href="/signin" style="color: var(--p31-accent);" class="hover:underline">Sign in</a>
        </p>
      </div>
    </div>
  </main>

  <Footer />
</MarketingShell>
