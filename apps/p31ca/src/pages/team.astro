---
import { getCollection } from 'astro:content';
import MarketingShell from '../layouts/MarketingShell.astro';
import SectionHeader from '../components/marketing/SectionHeader.astro';
import Footer from '../components/marketing/Footer.astro';
import Avatar from '../components/marketing/Avatar.astro';

const members = await getCollection('team');
const board = members.filter((m) => m.data.type === 'board');
const staff = members.filter((m) => m.data.type === 'staff');
const advisory = members.filter((m) => m.data.type === 'advisory');

---

<MarketingShell
  title="Team — P31 Labs"
  description="The people building sovereign infrastructure for neurodivergent families."
>
  <main id="main-content" class="section">
    <div class="max-w-4xl mx-auto px-6 md:px-12 lg:px-16">
      <SectionHeader
        title="Team"
        description="The people building sovereign infrastructure for neurodivergent families."
        align="left"
      />

      <div class="mt-16 space-y-8">

        <section>
          <h3 class="text-xl font-bold" style="color: var(--p31-text);">Staff</h3>
          <div class="mt-4 space-y-4">
            {staff.length === 0 && (
              <p class="text-base" style="color: var(--p31-text-secondary);">Building the team. The founder's bio is below.</p>
            )}
            {staff.map((m) => (
              <div class="glass-card" key={m.id}>
                <div class="p-6 flex gap-4 items-start">
                  <Avatar name={m.data.name} />
                  <div class="space-y-2">
                    <div class="flex flex-wrap items-baseline gap-2">
                      <h4 class="text-lg font-bold" style="color: var(--p31-text);">{m.data.name}</h4>
                      <span class="text-sm" style="color: var(--p31-accent);">{m.data.role}</span>
                    </div>
                    <p class="text-base leading-relaxed" style="color: var(--p31-text-secondary);">{m.data.bio}</p>
                    {m.data.pickle && (
                      <span class="inline-flex items-center gap-1 rounded-full border px-2.5 py-0.5 text-xs font-semibold"
                            style="border-color: var(--p31-glass-border, rgba(255,255,255,0.16)); color: var(--p31-text-tertiary);">
                        pickle · {m.data.pickle}
                      </span>
                    )}
                    {m.data.linkedin && (
                      <a href={m.data.linkedin} target="_blank" rel="noopener noreferrer"
                         class="inline-flex items-center gap-1 text-sm" style="color: var(--p31-accent);">
                        LinkedIn ↗
                      </a>
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>

        <section>
          <h3 class="text-xl font-bold" style="color: var(--p31-text);">Board</h3>
          <div class="mt-4 space-y-4">
            {board.length === 0 && (
              <p class="text-base" style="color: var(--p31-text-secondary);">
                Board seats are being formed as the organization grows. This section will fill in as the board is seated.
              </p>
            )}
            {board.map((m) => (
              <div class="glass-card" key={m.id}>
                <div class="p-6 flex gap-4 items-start">
                  <Avatar name={m.data.name} />
                  <div class="space-y-2">
                    <h4 class="text-lg font-bold" style="color: var(--p31-text);">{m.data.name}</h4>
                    <span class="text-sm" style="color: var(--p31-accent);">{m.data.role}</span>
                    <p class="text-base leading-relaxed" style="color: var(--p31-text-secondary);">{m.data.bio}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>

        <section>
          <h3 class="text-xl font-bold" style="color: var(--p31-text);">Advisory</h3>
          <div class="mt-4 space-y-4">
            {advisory.length === 0 && (
              <p class="text-base" style="color: var(--p31-text-secondary);">
                Advisory council seats are open. If you work in care infrastructure, quantum foundations, or family tech, reach out.
              </p>
            )}
            {advisory.map((m) => (
              <div class="glass-card" key={m.id}>
                <div class="p-6 flex gap-4 items-start">
                  <Avatar name={m.data.name} />
                  <div class="space-y-2">
                    <h4 class="text-lg font-bold" style="color: var(--p31-text);">{m.data.name}</h4>
                    <span class="text-sm" style="color: var(--p31-accent);">{m.data.role}</span>
                    <p class="text-base leading-relaxed" style="color: var(--p31-text-secondary);">{m.data.bio}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>

        <section>
          <h3 class="text-xl font-bold" style="color: var(--p31-text);">Contributors</h3>
          <p class="mt-4 text-base leading-relaxed" style="color: var(--p31-text-secondary);">
            P31 is open source. The <a href="/get-involved" style="color: var(--p31-accent);">Get Involved</a> page covers how to contribute — code, research, or community — and every contribution goes through review before it lands.
          </p>
        </section>

      </div>
    </div>
  </main>

  <Footer />
</MarketingShell>