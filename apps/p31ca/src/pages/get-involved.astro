---
import MarketingShell from '../layouts/MarketingShell.astro';

import SectionHeader from '../components/marketing/SectionHeader.astro';
import Footer from '../components/marketing/Footer.astro';
---

<MarketingShell theme="sunlight" title="Get Involved — P31 Labs" description="Support open-source assistive technology. Donate, deploy, or contribute to the sovereign stack.">
  <main id="main-content" class="section">
    <div class="gebb-max-w-5xl gebb-mx-auto gebb-px-6 gebb-md-px-12 gebb-lg-px-16">
      <SectionHeader level="1" title="Get Involved" description="Support open-source assistive technology. Donate, deploy, or contribute." />
      
      <div class="gebb-mt-16 gebb-space-y-12">
        {/* Donate */}
        <section class="gebb-dead-animate-fade-in-up gebb-delay-100">
          <h2 class="gebb-text-xl gebb-font-bold gebb-mb-6" style="color: var(--p31-text);">Donate</h2>
          <div data-p31="grid" data-cols="3" data-even class="gebb-gap-6">
            <a href="https://paypal.me/p31labs" target="_blank" rel="noopener" class="glass-card gebb-p-6 gebb-text-center gebb-hover-border-cyan-400-30 gebb-transition-all">
              <div class="gebb-text-3xl gebb-mb-3">💳</div>
              <h3 class="gebb-font-semibold gebb-mb-2" style="color: var(--p31-text);">PayPal</h3>
              <p class="gebb-text-sm" style="color: var(--p31-text-secondary);">One-time or recurring donations</p>
            </a>
            <a href="https://blockonomics.co/pay/p31labs" target="_blank" rel="noopener" class="glass-card gebb-p-6 gebb-text-center gebb-hover-border-cyan-400-30 gebb-transition-all">
              <div class="gebb-text-3xl gebb-mb-3">₿</div>
              <h3 class="gebb-font-semibold gebb-mb-2" style="color: var(--p31-text);">Bitcoin</h3>
              <p class="gebb-text-sm" style="color: var(--p31-text-secondary);">BTC via Blockonomics</p>
            </a>
            <a href="https://ko-fi.com/p31labs" target="_blank" rel="noopener" class="glass-card gebb-p-6 gebb-text-center gebb-hover-border-cyan-400-30 gebb-transition-all">
              <div class="gebb-text-3xl gebb-mb-3">☕</div>
              <h3 class="gebb-font-semibold gebb-mb-2" style="color: var(--p31-text);">Ko-fi</h3>
              <p class="gebb-text-sm" style="color: var(--p31-text-secondary);">Support with a coffee</p>
            </a>
          </div>
        </section>

        {/* Deploy */}
        <section class="gebb-dead-animate-fade-in-up gebb-delay-200">
          <h2 class="gebb-text-xl gebb-font-bold gebb-mb-6" style="color: var(--p31-text);">Deploy Your Own</h2>
          <div class="glass-card gebb-p-8">
            <p class="gebb-text-base gebb-leading-relaxed gebb-mb-6" style="color: var(--p31-text-secondary);">
              Clone the repo, run the CLI, and own your sovereign P31 stack. Zero server costs, open source, fully customizable.
            </p>
            <div class="gebb-space-y-3">
              <div class="gebb-flex gebb-items-center gebb-gap-3">
                <span class="gebb-text-sm gebb-font-mono gebb-px-2 gebb-py-1 gebb-rounded" style="background: rgba(6,182,212,0.1); color: var(--p31-accent); border: 1px solid rgba(6,182,212,0.2);">$ git clone https://github.com/p31labs/production</span>
              </div>
              <div class="gebb-flex gebb-items-center gebb-gap-3">
                <span class="gebb-text-sm gebb-font-mono gebb-px-2 gebb-py-1 gebb-rounded" style="background: rgba(6,182,212,0.1); color: var(--p31-accent); border: 1px solid rgba(6,182,212,0.2);">$ cd apps/p31ca && npm install && npm run deploy</span>
              </div>
            </div>
          </div>
        </section>

        {/* GitHub */}
        <section class="gebb-dead-animate-fade-in-up gebb-delay-300">
          <h2 class="gebb-text-xl gebb-font-bold gebb-mb-6" style="color: var(--p31-text);">Contribute</h2>
          <div data-p31="grid" data-cols="2" class="gebb-gap-6">
            <a href="https://github.com/p31labs/production" target="_blank" rel="noopener" class="glass-card gebb-p-6 gebb-hover-border-cyan-400-30 gebb-transition-all">
              <div class="gebb-flex gebb-items-start gebb-gap-4">
                <div class="gebb-text-2xl">📦</div>
                <div>
                  <h3 class="gebb-font-semibold gebb-mb-2" style="color: var(--p31-text);">GitHub</h3>
                  <p class="gebb-text-sm" style="color: var(--p31-text-secondary);">Star, fork, or contribute to the main repository. All code is AGPL-licensed.</p>
                </div>
              </div>
            </a>
            <a href="https://discord.gg/p31labs" target="_blank" rel="noopener" class="glass-card gebb-p-6 gebb-hover-border-cyan-400-30 gebb-transition-all">
              <div class="gebb-flex gebb-items-start gebb-gap-4">
                <div class="gebb-text-2xl">💬</div>
                <div>
                  <h3 class="gebb-font-semibold gebb-mb-2" style="color: var(--p31-text);">Discord</h3>
                  <p class="gebb-text-sm" style="color: var(--p31-text-secondary);">Join the community. Ask questions, share deployments, and meet other sovereign stack operators.</p>
                </div>
              </div>
            </a>
          </div>
        </section>
      </div>
    </div>
  </main>

  <Footer />
</MarketingShell>
