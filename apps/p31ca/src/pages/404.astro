---
import MarketingShell from '../layouts/MarketingShell.astro';
import SharedFooter from '../components/SharedFooter.astro';
---

<MarketingShell
  title="Not found — P31 Labs"
  description="This page does not exist. The dome is still here."
>

  <main class="nf-max-w-4xl nf-mx-auto nf-px-6 nf-md-px-12 nf-py-24 nf-text-center">
    <p class="nf-text-sm nf-tracking--0-3em- nf-uppercase" style="color: var(--p31-text-tertiary, #a3a3a3);">
      404
    </p>
    <h1 class="nf-mt-4 nf-text-4xl nf-md-text-5xl nf-font-bold" style="color: var(--p31-text, #e2e8f0);">
      This route is empty space
    </h1>
    <p class="nf-mt-6 nf-text-lg nf-leading-relaxed" style="color: var(--p31-text-secondary, #a3a3a3);">
      The page you tried to reach doesn't exist — but the dome, the starfield,
      and everything real underneath is still running.
    </p>
    <div class="nf-mt-10 nf-flex nf-justify-center">
      <a
        href="/"
        class="nf-inline-flex nf-items-center nf-gap-2 nf-rounded-full nf-px-6 nf-py-3 nf-text-sm nf-font-semibold nf-transition"
        style="background: var(--p31-accent, #22d3ee); color: #0a0a0f;"
      >
        Return to the homepage
      </a>
    </div>
  </main>

  <SharedFooter />
</MarketingShell>