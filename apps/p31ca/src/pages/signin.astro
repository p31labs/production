---
import MarketingShell from '../layouts/MarketingShell.astro';

import Footer from '../components/marketing/Footer.astro';
// NOTE: canon tokens.css is already loaded shell-wide via MarketingShell →
// p31-style.css → @p31ca/canon/css/all.css. Button uses the canon .btn
// recipe (fix-plan: p31ca-build-blocker-canon-and-canon-react.md).
---

<MarketingShell theme="sunlight" title="Sign In — P31 Labs" description="Sign in to your P31 Labs account. Email/password or DID:key.">
  <main id="main-content" class="section si3a-flex si3a-items-center si3a-justify-center">
    <div class="si3a-w-full si3a-max-w-md si3a-px-6 si3a-md-px-12 si3a-lg-px-16">
      <div class="glass-card animate-scale-in si3a-p-8 si3a-space-y-6">
        <div class="si3a-text-center si3a-space-y-2">
          <h1 class="si3a-text-2xl si3a-font-bold" style="color: var(--p31-text);">Sign In</h1>
          <p class="si3a-text-sm" style="color: var(--p31-text-secondary);">Access your sovereign P31 stack</p>
        </div>

        <form id="signin-form" class="si3a-space-y-4">
          <div class="si3a-space-y-2">
            <label for="email" class="si3a-text-sm si3a-font-medium" style="color: var(--p31-text);">Email</label>
            <input type="email" id="email" name="email" autocomplete="username" required class="si3a-w-full si3a-px-4 si3a-py-3 si3a-rounded-lg si3a-text-sm si3a-transition-all" style="background: rgba(255,255,255,0.03); border: 1px solid var(--p31-glass-border); color: var(--p31-text); outline: none;" onfocus="this.style.borderColor='var(--p31-accent)'" onblur="this.style.borderColor='var(--p31-glass-border)'" />
          </div>
          <div class="si3a-space-y-2">
            <label for="password" class="si3a-text-sm si3a-font-medium" style="color: var(--p31-text);">Password</label>
            <input type="password" id="password" name="password" autocomplete="current-password" required class="si3a-w-full si3a-px-4 si3a-py-3 si3a-rounded-lg si3a-text-sm si3a-transition-all" style="background: rgba(255,255,255,0.03); border: 1px solid var(--p31-glass-border); color: var(--p31-text); outline: none;" onfocus="this.style.borderColor='var(--p31-accent)'" onblur="this.style.borderColor='var(--p31-glass-border)'" />
            <p class="si3a-text-xs" style="color: var(--p31-text-tertiary);">
              Passwordless stack: your password is never sent or checked — it exists for browser password-manager compatibility.
            </p>
          </div>
          <button type="submit" class="btn btn-primary si3a-w-full" id="signin-submit">Sign In</button>
          <p id="signin-status" role="status" aria-live="polite" class="si3a-text-xs" style="display: none; color: var(--p31-text-secondary);"></p>
        </form>

        <div class="si3a-relative si3a-py-4" style="border-top: 1px solid var(--p31-glass-border);">
          <span class="si3a-absolute si3a-top-1-2 si3a-left-1-2 si3a-text-xs si3a-px-2" style="background: var(--p31-bg); color: var(--p31-text-tertiary); translate: -50% -50%;">or</span>
        </div>

        <div class="si3a-space-y-3">
          <a href="https://phos.p31ca.org" class="btn btn-secondary si3a-w-full si3a-justify-center" style="text-decoration: none;">
            <span style="font-family: var(--p31-font-mono);">🔑</span>
            <span>Sign In with DID:key in PHOS</span>
          </a>
          <p class="si3a-text-xs si3a-text-center" style="color: var(--p31-text-tertiary);">
            DID:key signing needs your key material, and this hub never asks for keys. PHOS signs DID challenges client-side — sign in there.
          </p>
        </div>

        <p class="si3a-text-xs si3a-text-center" style="color: var(--p31-text-tertiary);">
          Don't have an account? <a href="/signup" style="color: var(--p31-accent);" class="si3a-hover-underline">Sign up</a>
        </p>
      </div>
    </div>
  </main>

  <Footer />

  <script>
    (() => {
      // Real submit against the live p31-auth worker (apps/auth, deployed).
      // Contract: POST { pseudonym } → { token, userId, pseudonym }.
      // The hub is passwordless — the email string is the pseudonym; the
      // password field is validated locally and never transmitted.
      const AUTH_LOGIN = 'https://p31-auth.trimtab-signal.workers.dev/auth/login';
      const form = document.getElementById('signin-form') as HTMLFormElement | null;
      const status = document.getElementById('signin-status') as HTMLElement | null;
      const submit = document.getElementById('signin-submit') as HTMLButtonElement | null;
      if (!form || !status || !submit) return;

      const show = (text: string, ok: boolean) => {
        status.textContent = text;
        status.style.color = ok ? 'var(--p31-accent-green, #34d399)' : 'var(--p31-accent-red, #fb7185)';
        status.style.display = 'block';
      };

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = (document.getElementById('email') as HTMLInputElement).value.trim();
        const password = (document.getElementById('password') as HTMLInputElement).value;
        if (!email || !password) {
          show('Enter your email and password first.', false);
          return;
        }
        submit.disabled = true;
        show('Contacting p31-auth…', true);
        try {
          const res = await fetch(AUTH_LOGIN, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ pseudonym: email }),
          });
          if (!res.ok) {
            const body = await res.json().catch(() => null);
            show(`p31-auth answered ${res.status}: ${body?.error ?? 'try again'}.`, false);
            return;
          }
          const data = await res.json();
          sessionStorage.setItem('p31-auth-token', data.token);
          show(
            `Signed in as ${data.userId} — a real session token is stored in this tab. Your password was not sent or checked.`,
            true
          );
        } catch {
          show('Could not reach p31-auth (offline or blocked). Nothing was stored.', false);
        } finally {
          submit.disabled = false;
        }
      });
    })();
  </script>
</MarketingShell>