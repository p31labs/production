---
/**
 * /press — the press page.
 *
 * Honest state: P31 has not yet been covered by the press. This page says so
 * plainly and provides what exists (brand images) plus the press contact.
 * Nothing is faked — when coverage happens, it will be listed here with
 * dates and links.
 */
import MarketingShell from '../layouts/MarketingShell.astro';
import SectionHeader from '../components/marketing/SectionHeader.astro';
import Footer from '../components/marketing/Footer.astro';
import constants from '../data/p31-mesh-constants.json';

const CONTACT_EMAIL = constants.contactEmail;
---

<MarketingShell
  title="Press — P31 Labs"
  description="Press materials and contact. P31 has not yet been covered by the press; this page is the honest front door for coverage when it happens."
>
  <main id="main-content" class="section">
    <div class="prd3-max-w-3xl prd3-mx-auto prd3-px-6 prd3-md-px-12 prd3-lg-px-16">
      <SectionHeader
        level="1"
        title="Press"
        description="For coverage and interviews."
        align="left"
      />

      <div class="prd3-mt-16 prd3-space-y-6">

        <section class="glass-card" style="border-left: 3px solid var(--p31-signal-amber, #f59e0b);">
          <div class="prd3-p-8 prd3-space-y-3">
            <h2 class="prd3-text-xl prd3-font-bold" style="color: var(--p31-text);">The honest state</h2>
            <p class="prd3-text-base prd3-leading-relaxed" style="color: var(--p31-text-secondary);">
              P31 has not yet been covered by the press. When coverage happens, it will be listed here with dates and links. Until then, this page states the facts plainly rather than padding the section.
            </p>
            <p class="prd3-text-base prd3-leading-relaxed" style="color: var(--p31-text);">
              For interviews and press inquiries: <a href={`mailto:${CONTACT_EMAIL}`} style="color: var(--p31-accent);">{CONTACT_EMAIL}</a>
            </p>
          </div>
        </section>

        <section class="glass-card">
          <div class="prd3-p-8 prd3-space-y-3">
            <h2 class="prd3-text-xl prd3-font-bold" style="color: var(--p31-text);">Brand assets</h2>
            <p class="prd3-text-base prd3-leading-relaxed" style="color: var(--p31-text-secondary);">
              A full media kit is not yet assembled. The brand mark and social images below are the current public assets.
            </p>
            <div data-p31="grid" data-cols="2" data-even class="prd3-gap-4">
              <a href="/og-image.svg" target="_blank" rel="noopener noreferrer" class="prd3-rounded-xl prd3-border prd3-p-5 prd3-block prd3-transition" style="border-color: var(--p31-glass-border, rgba(255,255,255,0.1)); background: var(--p31-panel-surface, rgba(255,255,255,0.04));">
                <div class="prd3-font-semibold" style="color: var(--p31-text);">Brand mark (SVG)</div>
                <p class="prd3-mt-1 prd3-text-sm" style="color: var(--p31-text-secondary);">The P31 mark.</p>
              </a>
              <a href="/og-image.svg" target="_blank" rel="noopener noreferrer" class="prd3-rounded-xl prd3-border prd3-p-5 prd3-block prd3-transition" style="border-color: var(--p31-glass-border, rgba(255,255,255,0.1)); background: var(--p31-panel-surface, rgba(255,255,255,0.04));">
                <div class="prd3-font-semibold" style="color: var(--p31-text);">Social card (SVG)</div>
                <p class="prd3-mt-1 prd3-text-sm" style="color: var(--p31-text-secondary);">Default social share image.</p>
              </a>
            </div>
          </div>
        </section>

      </div>
    </div>
  </main>

  <Footer />
</MarketingShell>