---
/**
 * Research — the credibility page.
 *
 * Renders the 22 verified P31 papers (src/data/p31-research.ts) as a card
 * grid, plus a DOI timeline diagram and a "how to cite" block. Every DOI
 * resolves via the canonical https://doi.org/ resolver.
 *
 * The timeline diagram is passed to set:html as a frontmatter string so the
 * Mermaid source never enters the JSX parser (the pattern established on
 * /enterprise and /about).
 */
import MarketingShell from '../layouts/MarketingShell.astro';
import SectionHeader from '../components/marketing/SectionHeader.astro';
import ResearchCard from '../components/marketing/ResearchCard.astro';
import Footer from '../components/marketing/Footer.astro';
import { papers } from '../data/p31-research.ts';

const publishedCount = papers.length;

/** The DOI timeline — grouped by publication period. */
const researchTimeline = `
timeline
    2026-01 : Tetrahedron Protocol published
    2026-04 : Genesis Whitepaper + Sovereign Stack
            : Papers V-XX batch-uploaded to Zenodo
    2026-05 : Paper XII (Sovereign Stack) published
    2026-09 : All ${publishedCount} DOIs verified live
`;

/** The citation block — BibTeX + plain-text, resolver-format DOI. */
const bibtex = `@misc{p31labs2026,
  title        = {P31 Research Series: Papers I--XX + Standalone},
  author       = {{P31 Labs, Inc.}},
  year         = {2026},
  howpublished = {Zenodo},
  note         = {Open-access, DOI-registered},
  url          = "https://zenodo.org/communities/p31labs"
}`;

const plainCitation = `P31 Labs, Inc. (2026). P31 Research Series: Papers I–XX + Standalone. Zenodo. https://zenodo.org/communities/p31labs`;
---

<MarketingShell
  title="Research — P31 Labs"
  description={`${publishedCount} papers on Zenodo. Citable, immutable, open. From the Tetrahedron Protocol to the Sovereign Stack.`}
>
  <main id="main-content" class="section">
    <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-16">
      <SectionHeader
        title="Research"
        description={`${publishedCount} papers published on Zenodo. Citable, immutable, open. From SIC-POVM to the Sovereign Stack.`}
      />

      {/* ── THE DOI TIMELINE ── */}
      <section class="mb-16">
        <h2 class="text-2xl font-bold mb-6" style="color: var(--p31-text);">Publication timeline</h2>
        <div class="glass-card p-6 rounded-xl overflow-x-auto">
          <pre class="mermaid" set:html={researchTimeline} />
        </div>
      </section>

      {/* ── HOW TO CITE ── */}
      <section class="mb-16">
        <h2 class="text-2xl font-bold mb-6" style="color: var(--p31-text);">How to cite P31</h2>
        <div class="space-y-6">
          <div class="glass-card p-6 rounded-xl">
            <h3 class="font-mono text-sm font-semibold mb-3" style="color: var(--p31-accent);">BIBTEX</h3>
            <pre class="font-mono text-xs leading-relaxed overflow-x-auto" style="color: var(--p31-text-secondary);"><code>{bibtex}</code></pre>
          </div>
          <div class="glass-card p-6 rounded-xl flex flex-col gap-4">
            <h3 class="font-mono text-sm font-semibold" style="color: var(--p31-accent);">APA 7TH EDITION</h3>
            <p class="text-sm leading-relaxed" style="color: var(--p31-text-secondary);">{plainCitation}</p>
            <a
              href="https://zenodo.org/communities/p31labs"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 text-sm font-medium"
              style="color: var(--p31-accent);"
            >
              View the community on Zenodo ↗
            </a>
            <p class="text-xs mt-auto" style="color: var(--p31-text-tertiary, #a1a1a1);">
              All DOIs resolve via <span class="font-mono">https://doi.org/</span> — the canonical resolver. No vendor lock-in.
            </p>
          </div>
        </div>
      </section>

      {/* ── PAPER GRID ── */}
      <section class="mb-16">
        <h2 class="text-2xl font-bold mb-6" style="color: var(--p31-text);">All {publishedCount} papers</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {papers.map((paper) => (
            <ResearchCard {...paper} />
          ))}
        </div>
      </section>

      {/* ── CTA ── */}
      <section class="text-center mb-16">
        <a
          href="https://zenodo.org/communities/p31labs"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full px-8 py-4 text-lg font-semibold transition"
          style="background: var(--p31-accent); color: #0a0a0f;"
        >
          View all on Zenodo ↗
        </a>
        <p class="mt-4 text-sm" style="color: var(--p31-text-tertiary, #a1a1a1);">
          Every DOI verified live, 2026-09-23. No placeholder citations — a fabricated citation is worse than none.
        </p>
      </section>
    </div>
  </main>

  <Footer />
</MarketingShell>