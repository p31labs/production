---
import MarketingShell from '../layouts/MarketingShell.astro';

import SectionHeader from '../components/marketing/SectionHeader.astro';
import Footer from '../components/marketing/Footer.astro';

const games = [
  { id: 'bashball', title: 'Bashball', description: 'CLI baseball simulation. Script your lineup, manage stats, and play a full season in your terminal.', icon: '⚾' },
  { id: 'liquid', title: 'Liquid', description: 'Dynamic fluid simulation in your browser. Watch particles flow, collide, and merge in real-time.', icon: '💧' },
  { id: 'orbital', title: 'Orbital', description: 'Physics-based orbital mechanics. Launch payloads, maintain satellites, and manage space debris.', icon: '🛰️' },
  { id: 'poetry', title: 'Poetry', description: 'Algorithmic poetry generator. Explore the intersection of computation and creative expression.', icon: '✍️' },
  { id: 'resonance', title: 'Resonance', description: 'Interactive audio visualization. See sound waves, frequencies, and harmonics come alive.', icon: '🎵' },
  { id: 'strategy', title: 'Strategy', description: 'Turn-based strategy game with sovereign mechanics. Build, trade, and negotiate with AI opponents.', icon: '♟️' },
];
---

<MarketingShell title="Arcade — P31 Labs" description="Interactive games and simulations. From terminal baseball to orbital mechanics.">
  <main id="main-content" class="section">
    <div class="ar08-max-w-4xl ar08-mx-auto ar08-px-6 ar08-md-px-12 ar08-lg-px-16">
      <SectionHeader level="1" title="Arcade" description="Interactive games and simulations. From terminal baseball to orbital mechanics." />
      
      <div data-p31="grid" data-cols="3" data-even class="ar08-mt-16 ar08-gap-6">
        {games.map((game) => (
          <article class="glass-card ar08-dead-animate-fade-in-up group ar08-cursor-pointer" style={`transition-delay: ${games.indexOf(game) * 100}ms;`}>
            <div class="ar08-p-8 ar08-space-y-4" style="display:flex;flex-direction:column;flex:1;">
              <div class="ar08-text-4xl ar08-group-hover-scale-110 ar08-transition-transform ar08-duration-300" style="display: inline-block;">{game.icon}</div>
              <h2 class="ar08-text-xl ar08-font-bold" style="color: var(--p31-text);">{game.title}</h2>
              <p class="ar08-text-sm ar08-leading-relaxed" style="color: var(--p31-text-secondary);">{game.description}</p>
              <div class="ar08-pt-4 ar08-flex ar08-items-center ar08-gap-2 ar08-text-sm ar08-font-medium" style="color: var(--p31-accent);">
                <span>Play now</span>
                <span class="ar08-group-hover-translate-x-1 ar08-transition-transform ar08-duration-200">→</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</MarketingShell>
