---
/**
 * /security — the security posture, documented honestly.
 *
 * Everything here matches what is actually deployed. Headers were verified
 * against the live site; the controls below come from EDGE-SECURITY.md and
 * the deployed .well-known/security.txt. No SOC 2 / ISO 27001 is claimed —
 * this page documents the controls that ARE in place, including the known
 * trade-offs.
 */
import MarketingShell from '../layouts/MarketingShell.astro';
import SectionHeader from '../components/marketing/SectionHeader.astro';
import Footer from '../components/marketing/Footer.astro';
import constants from '../data/p31-mesh-constants.json';

const SECURITY_EMAIL = constants.securityEmail;
const CONTACT_EMAIL = constants.contactEmail;

// Headers are read from public/_headers (the deployment source of truth) so
// this page can never drift from what is actually served. Matched by name.
// The path is context-dependent: from the source file it is ../../, but the
// Astro build compiles pages into dist/_worker.js/pages/ where it becomes
// ../../../ — so we try both and fail loudly if neither exists.
import { readFileSync, existsSync } from 'node:fs';
const HEADER_CANDIDATES = [
  new URL('../../public/_headers', import.meta.url).pathname,
  new URL('../../../public/_headers', import.meta.url).pathname,
].filter((p) => existsSync(p));
if (HEADER_CANDIDATES.length === 0) {
  throw new Error('[security.astro] cannot locate public/_headers — the header documentation would be a lie.');
}
const HEADERS_SOURCE = readFileSync(HEADER_CANDIDATES[0], 'utf-8');
const headerValue = (name: string): string => {
  const re = new RegExp('^\\s*' + name.replace(/[-]/g, '\\-') + ':\\s*(.+)$', 'm');
  const m = HEADERS_SOURCE.match(re);
  return m ? m[1].trim() : '(not set)';
};

const headers = [
  { name: 'Strict-Transport-Security', value: headerValue('Strict-Transport-Security'), note: 'Forces HTTPS for a year, including subdomains, with preload intent.' },
  { name: 'Content-Security-Policy', value: headerValue('Content-Security-Policy'), note: "The full deployed CSP. Blocks framing (frame-ancestors 'none') and restricts scripts/styles/fonts/images/connections to known origins. 'unsafe-inline' in script-src is a known trade-off for Astro's inline hydration scripts — a nonce pipeline is a P2 improvement." },
  { name: 'Permissions-Policy', value: headerValue('Permissions-Policy'), note: 'Disables camera, microphone, and geolocation at the document level.' },
  { name: 'Referrer-Policy', value: headerValue('Referrer-Policy'), note: 'Sends only the origin, never the full URL, cross-site.' },
  { name: 'X-Content-Type-Options', value: headerValue('X-Content-Type-Options'), note: 'Prevents MIME-sniffing.' },
  { name: 'X-Frame-Options', value: headerValue('X-Frame-Options'), note: 'Rejects all framing.' },
];

const subProcessors = [
  { name: 'Cloudflare', purpose: 'Edge network — Pages, Workers, D1, TLS, DDoS mitigation' },
  { name: 'GitHub', purpose: 'Open-source source hosting under the p31labs org' },
  { name: 'Zenodo', purpose: 'Open-access research hosting (DOIs)' },
  { name: 'Stripe', purpose: 'Donation payment processing' },
  { name: 'Ko-fi', purpose: 'Donation / subscription processing' },
  { name: 'PayPal', purpose: 'Donation payment processing' },
  { name: 'Blockonomics', purpose: 'Cryptocurrency donation processing' },
];
---

<MarketingShell
  title="Security — P31 Labs"
  description="The security posture, documented honestly — deployed headers, vulnerability disclosure, sub-processors, and the controls that are in place."
>
  <main id="main-content" class="section">
    <div class="max-w-3xl mx-auto px-6 md:px-12 lg:px-16">
      <SectionHeader
        title="Security"
        description="The posture, documented honestly — what is deployed, what is in scope, and what is not yet done."
        align="left"
      />

      <div class="mt-16 space-y-6">

        <section class="glass-card">
          <div class="p-8 space-y-4">
            <h3 class="text-xl font-bold" style="color: var(--p31-text);">Security headers</h3>
            <p class="text-sm" style="color: var(--p31-text-secondary);">Verified against the live site. These are applied at the Cloudflare edge.</p>
            <div class="mt-2 space-y-3">
              {headers.map((h) => (
                <div class="rounded-xl border p-4" style="border-color: var(--p31-glass-border, rgba(255,255,255,0.1)); background: var(--p31-panel-surface, rgba(255,255,255,0.04));">
                  <div class="font-mono text-sm font-bold" style="color: var(--p31-accent);">{h.name}</div>
                  <div class="mt-1 font-mono text-xs break-all" style="color: var(--p31-text-secondary);">{h.value}</div>
                  <p class="mt-2 text-sm leading-relaxed" style="color: var(--p31-text-tertiary, #a1a1a1);">{h.note}</p>
                </div>
              ))}
            </div>
          </div>
        </section>

        <section class="glass-card">
          <div class="p-8 space-y-4">
            <h3 class="text-xl font-bold" style="color: var(--p31-text);">Vulnerability disclosure</h3>
            <p class="text-base leading-relaxed" style="color: var(--p31-text-secondary);">
              Report a security issue to <a href={`mailto:${SECURITY_EMAIL}`} style="color: var(--p31-accent);">{SECURITY_EMAIL}</a> or <a href={`mailto:${CONTACT_EMAIL}`} style="color: var(--p31-accent);">{CONTACT_EMAIL}</a>. We aim to acknowledge responsible reports promptly. See <a href="/.well-known/security.txt" style="color: var(--p31-accent);">.well-known/security.txt</a> for the machine-readable disclosure — which carries the plain addresses and is not obfuscated. For how the audit chain maps to audit-logging requirements, see <a href="/compliance" style="color: var(--p31-accent);">Compliance</a>.
            </p>
            <p class="text-sm leading-relaxed" style="color: var(--p31-text-tertiary, #a1a1a1);">
              There is no bounty program at this time. We do not pursue legal action for good-faith security research.
            </p>
          </div>
        </section>

        <section class="glass-card">
          <div class="p-8 space-y-4">
            <h3 class="text-xl font-bold" style="color: var(--p31-text);">Data handling</h3>
            <ul class="list-disc pl-5 space-y-2 text-base leading-relaxed" style="color: var(--p31-text-secondary);">
              <li>No server-side identity store — the did:key is generated and stored on the device.</li>
              <li>The audit chain records that an action happened and by whom, not content — in D1, backed up to R2.</li>
              <li>No analytics, no tracking. The zero-telemetry posture is a documented build gate.</li>
            </ul>
          </div>
        </section>

        <section class="glass-card">
          <div class="p-8 space-y-4">
            <h3 class="text-xl font-bold" style="color: var(--p31-text);">Sub-processors</h3>
            <div class="mt-2 space-y-2">
              {subProcessors.map((sp) => (
                <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-3 rounded-xl border p-3" style="border-color: var(--p31-glass-border, rgba(255,255,255,0.1));">
                  <div class="font-semibold sm:min-w-[140px]" style="color: var(--p31-text);">{sp.name}</div>
                  <div class="text-sm" style="color: var(--p31-text-secondary);">{sp.purpose}</div>
                </div>
              ))}
            </div>
          </div>
        </section>

        <section class="glass-card" style="border-left: 3px solid var(--p31-signal-amber, #f59e0b);">
          <div class="p-8 space-y-4">
            <h3 class="text-xl font-bold" style="color: var(--p31-text);">The honest scope</h3>
            <p class="text-base leading-relaxed" style="color: var(--p31-text-secondary);">
              P31 has not obtained SOC 2 or ISO 27001 certification. This page documents the controls that <strong style="color: var(--p31-text);">are</strong> in place. Known trade-offs are stated rather than hidden: the CSP uses <span class="font-mono">'unsafe-inline'</span> for Astro's inline hydration scripts (a nonce pipeline is a P2 improvement), and the passkey worker returns <span class="font-mono">Access-Control-Allow-Origin: *</span> by design — WebAuthn trusts the rpId, not CORS.
            </p>
            <p class="text-sm" style="color: var(--p31-text-tertiary, #a1a1a1);">
              Machine-readable disclosure: <a href="/.well-known/security.txt" style="color: var(--p31-accent);">.well-known/security.txt</a>.
            </p>
          </div>
        </section>

      </div>
    </div>
  </main>

  <Footer />
</MarketingShell>