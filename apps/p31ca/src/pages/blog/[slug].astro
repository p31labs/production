---
import { getCollection } from 'astro:content';
import MarketingShell from '../../layouts/MarketingShell.astro';
import SectionHeader from '../../components/marketing/SectionHeader.astro';
import Footer from '../../components/marketing/Footer.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { title, date, author, excerpt, source, sourceUrl } = post.data;
// Content-collection entry id includes the `.md` extension; the blog slug
// (and the forum thread id, which must match it exactly) strips it.
const slug = post.id.replace(/\.md$/, '');
const discussUrl = `https://workspace.p31ca.org/forum/thread/${slug}`;
const isImported = source === 'substack';
const site = 'https://p31ca.org';
// The webmention endpoint on forum-api — replies/likes/reposts from other
// sites fold into the forum thread for this post.
const wmUrl = `https://forum-api.trimtab-signal.workers.dev/threads/${slug}/webmentions`;
---

<MarketingShell
  theme="sunlight"
  title={`${title} — P31 Labs`}
  description={excerpt}
>
  <main id="main-content" class="section">
    <div class="max-w-3xl mx-auto px-6 md:px-12">
      <SectionHeader title={title} description={`${date} · ${author}`} />
      <!-- h-entry microformats — IndieWeb: makes this post a first-class
           entry that webmentions and POSSE (Mastodon/Bluesky bridges) can
           parse and reply to. role="main" is the landmark (Phase A). -->
      <article class="h-entry prose prose-invert mt-10" role="main">
        <a class="u-url" href={`${site}/blog/${slug}`} hidden></a>
        <h1 class="p-name" hidden>{title}</h1>
        <div class="e-content" set:html={post.body} />
      </article>

      {isImported && (
        <p class="text-xs mt-4" style="color: var(--p31-text-tertiary);">
          Originally published on <a href={sourceUrl} rel="noopener">the geodesic self</a> ·
          this copy is the canonical archive.
        </p>
      )}

      <!-- Webmention endpoint link — tells other sites where to send mentions -->
      <link rel="webmention" href="https://forum-api.trimtab-signal.workers.dev/webmention" hidden />

      <!-- Standard.site (Phase G) — the ATProto record link + publication
           verification. Tells Bluesky/Bluesky apps where this post's record
           lives; the projection worker serves the other half of the loop at
           /.well-known/site.standard.publication. -->
      <link rel="site.standard.document" href={`https://standard-site-projection.trimtab-signal.workers.dev/site.standard.document/${slug}`} hidden />
      <link rel="site.standard.publication" href="https://standard-site-projection.trimtab-signal.workers.dev/.well-known/site.standard.publication" hidden />

      <aside class="glass-card p-6 mt-12">
        <p style="color: var(--p31-text-secondary);">
          Discuss this post — questions, corrections, and accepted answers live
          in the forum. Replies from other sites arrive here as webmentions.
        </p>
        <a class="btn btn-primary mt-3" href={discussUrl} rel="noopener">
          Open thread →
        </a>
      </aside>

      <!-- Webmentions: remote replies/likes/reposts, fetched from the forum's
           D1. Rendered client-side (the forum API is a live Worker). -->
      <aside class="glass-card p-6 mt-12" data-webmentions data-src={wmUrl} aria-label="Replies from the web">
        <p style="color: var(--p31-text-secondary);">Replies from across the web</p>
        <div id="webmentions-list" style="margin-top: var(--p31-space-3);">
          <span style="color: var(--p31-cloud); font-size: var(--p31-text-sm);">loading…</span>
        </div>
      </aside>
    </div>
  </main>
  <Footer />

  <script>
    // Fetch webmentions for this post from the forum's D1 and render them.
    const el = document.querySelector('[data-webmentions]');
    if (el) {
      const src = el.getAttribute('data-src') ?? '';
      fetch(src)
        .then((r) => r.json())
        .then((d) => {
          const list = document.getElementById('webmentions-list');
          if (!list) return;
          const wm = Array.isArray(d?.webmentions) ? d.webmentions : [];
          if (wm.length === 0) {
            list.innerHTML = '<span style="color: var(--p31-cloud); font-size: var(--p31-text-sm);">No replies yet.</span>';
            return;
          }
          list.innerHTML = wm
            .map(
              (w) =>
                `<div style="padding: var(--p31-space-3); border-bottom: 1px solid var(--p31-glass-border);">
                  <div style="font-size: var(--p31-text-sm);">
                    <strong>${w.type}</strong>
                    ${w.author_name ? ` · <em>${w.author_name}</em>` : ''}
                    <span style="color: var(--p31-cloud);"> · ${new Date(w.created_at).toLocaleDateString()}</span>
                  </div>
                  ${w.content ? `<p style="margin-top: var(--p31-space-1);">${w.content}</p>` : ''}
                  <a href="${w.source}" rel="noopener" style="font-size: var(--p31-text-xs); color: var(--p31-accent);">source</a>
                </div>`,
            )
            .join('');
        })
        .catch(() => {
          const list = document.getElementById('webmentions-list');
          if (list) list.textContent = 'Replies unavailable — the forum API is offline.';
        });
    }
  </script>
</MarketingShell>