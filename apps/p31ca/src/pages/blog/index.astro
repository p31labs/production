---
import MarketingShell from '../../layouts/MarketingShell.astro';
import CanonTopbar from '../../components/islands/CanonTopbar.tsx';

import SectionHeader from '../../components/marketing/SectionHeader.astro';
import Footer from '../../components/marketing/Footer.astro';
import { getCollection } from 'astro:content';

// The blog index: natively-authored posts (live local pages) + posts imported
// from the geodesic self Substack via scripts/fetch-substack.mjs (the
// self-hosted canonical archive). The old blog-posts.json substack.com/p1-*
// outlinks were dead URLs and have been retired.
const imported = (await getCollection('blog'))
  .map((p) => ({ ...p.data, url: `/blog/${p.id.replace(/\.md$/, '')}` }))
  .sort((a, b) => b.date.localeCompare(a.date));
const native = [
  {
    title: 'I built a governed MCP marketplace from an island in Georgia',
    date: '2026-09-29',
    excerpt: 'A DoD civilian engineering technician on a Georgia island built a governed MCP marketplace — and found three bugs in the ecosystem the industry doesn\u2019t know it has.',
    url: '/blog/mcp-marketplace',
    source: 'local',
  },
];
const posts = [...native, ...imported];
---

<MarketingShell theme="sunlight" title="Blog — P31 Labs" description="Thoughts on sovereign infrastructure, neurodivergent technology, and open science.">
  
    <CanonTopbar client:load />
  <main id="main-content" class="section">
    <div class="max-w-4xl mx-auto px-6 md:px-12 lg:px-16">
      <SectionHeader title="Blog" description="Thoughts on sovereign infrastructure, neurodivergent technology, and open science." />
      
      <div class="mt-16 space-y-8">
        {posts.map((post, i) => (
          <a href={post.url} class="glass-card animate-fade-in-up block no-underline" style="animation-delay: {i * 100}ms;">
            <div class="p-8">
              <div class="flex items-center gap-3 mb-4">
                <time class="text-xs font-mono" style="color: var(--p31-text-tertiary);">{post.date}</time>
                <span class="text-xs" style="color: var(--p31-text-tertiary);">·</span>
                <span class="text-xs font-medium" style="color: var(--p31-accent);">{post.source === 'substack' ? 'the geodesic self' : 'P31'}</span>
              </div>
              <h3 class="text-xl font-bold mb-3" style="color: var(--p31-text);">{post.title}</h3>
              <p class="text-sm leading-relaxed mb-4" style="color: var(--p31-text-secondary);">{post.excerpt}</p>
              <span class="text-sm font-medium inline-flex items-center gap-1" style="color: var(--p31-accent);">
                Read more
                <span class="group-hover:translate-x-1 transition-transform">→</span>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</MarketingShell>