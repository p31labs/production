---
/**
 * /faq — honest answers to the questions a visitor actually asks.
 *
 * Content comes from the `faq` content collection (src/content/faq/*.md) —
 * file-based, type-safe, one entry per question. Emits FAQPage JSON-LD for
 * schema.org. Every answer is honest about what is shipped vs planned; no
 * invented capabilities.
 */
import { getCollection } from 'astro:content';
import MarketingShell from '../layouts/MarketingShell.astro';
import SectionHeader from '../components/marketing/SectionHeader.astro';
import Footer from '../components/marketing/Footer.astro';
import FaqBody from '../components/marketing/FaqBody.astro';

const faqs = await getCollection('faq');

const categories: { id: string; label: string }[] = [
  { id: 'stack', label: 'The stack' },
  { id: 'family', label: 'The family test' },
  { id: 'nonprofit', label: 'The nonprofit' },
  { id: 'commercial', label: 'The commercial offering' },
  { id: 'community', label: 'Community' },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.data.q,
    acceptedAnswer: { "@type": "Answer", text: f.data.a },
  })),
};
---

<MarketingShell
  title="FAQ — P31 Labs"
  description="Honest answers about the stack, the family test, the nonprofit, and the commercial offering."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <main id="main-content" class="section">
    <div class="max-w-3xl mx-auto px-6 md:px-12 lg:px-16">
      <SectionHeader
        title="FAQ"
        description="Honest answers. What is shipped is stated as shipped; what is planned is stated as planned."
        align="left"
      />

      <div class="mt-16 space-y-12">
        {categories.map((cat) => {
          const items = faqs.filter((f) => f.data.category === cat.id);
          if (items.length === 0) return null;
          return (
            <section key={cat.id}>
              <h2 class="text-xl font-bold mb-4" style="color: var(--p31-text);">{cat.label}</h2>
              <div class="space-y-3">
                {items.map((item) => (
                  <details
                    key={item.id}
                    class="glass-card rounded-xl overflow-hidden"
                    style="border: 1px solid var(--p31-glass-border, rgba(255,255,255,0.1));"
                  >
                    <summary
                      class="cursor-pointer select-none px-6 py-4 flex items-center justify-between gap-4"
                      style="color: var(--p31-text); font-weight: 600;"
                    >
                      {item.data.q}
                      <span class="shrink-0 text-xs" style="color: var(--p31-accent);" aria-hidden="true">+</span>
                    </summary>
                    <div class="px-6 pb-5 pt-0 text-base leading-relaxed" style="color: var(--p31-text-secondary);">
                      {item.data.a}
                      <div class="mt-3 pt-3" style="border-top: 1px solid var(--p31-glass-border, rgba(255,255,255,0.08));">
                        <FaqBody entry={item} />
                      </div>
                    </div>
                  </details>
                ))}
              </div>
            </section>
          );
        })}
      </div>
    </div>
  </main>

  <Footer />
</MarketingShell>