---
/**
 * /ways-to-give — the donation taxonomy.
 *
 * Only paths with a registered destination are listed as active. Paths that
 * are planned but not yet wired are marked "coming" — no fake links, no
 * dead ends. Every active link resolves from src/data/p31-mesh-constants.json.
 */
import MarketingShell from '../layouts/MarketingShell.astro';
import SectionHeader from '../components/marketing/SectionHeader.astro';
import Footer from '../components/marketing/Footer.astro';
import constants from '../data/p31-mesh-constants.json';

const CONTACT_EMAIL = constants.contactEmail;

const treasuryFlow = `
flowchart LR
    classDef core fill:#2563eb,stroke:#1e40af,color:#ffffff
    classDef store fill:#64748b,stroke:#334155,color:#ffffff
    classDef success fill:#10b981,stroke:#047857,color:#ffffff
    A["Donation"]:::core --> B["D1 ledger"]:::store
    B --> C["Quarterly report"]:::success
    B --> D["Form 990"]:::success
`;

const paths = [
  { label: 'Open Collective', desc: 'Transparent recurring giving with a public ledger.', href: constants.openCollectiveUrl, status: 'active' },
  { label: 'GitHub Sponsors', desc: 'Sponsor the open-source work directly on GitHub — recurring or one-time.', href: constants.githubSponsorsUrl, status: 'active' },
  { label: 'One-time gift', desc: 'A single donation, any amount. Fastest way to support the work.', href: 'https://buy.stripe.com/5kQ14g827gmpcHFb0W8Ra00', status: 'active' },
  { label: 'Recurring support', desc: 'Monthly giving via Ko-fi — sustains ongoing R&D and hosting.', href: 'https://ko-fi.com/p31labs', status: 'active' },
  { label: 'Operations fund', desc: 'Direct operating support for the day-to-day infrastructure.', href: 'https://ko-fi.com/trimtab69420', status: 'active' },
  { label: 'Fiscal sponsorship', desc: 'Backed by Hack Club HCB — a fiscal host for open-source nonprofits.', href: 'https://hcb.hackclub.com/donations/start/p31-labs', status: 'active' },
  { label: 'PayPal', desc: 'PayPal.me — a simple, familiar route.', href: 'https://paypal.me/p31labs', status: 'active' },
  { label: 'Crypto', desc: 'BTC and other coins via Blockonomics.', href: 'https://blockonomics.co/pay/p31labs', status: 'active' },
  { label: 'Research funding', desc: 'Sponsor the open research program on Zenodo.', href: 'https://zenodo.org/communities/p31labs', status: 'active' },
  { label: 'Planned giving', desc: 'Bequests and legacy gifts. Structured path coming.', href: null, status: 'coming' },
  { label: 'Stock / DAF', desc: 'Donor-advised funds and stock transfers. Coming.', href: null, status: 'coming' },
  { label: 'In-kind', desc: 'Hardware, hosting, and services. Contact us directly.', href: `mailto:${CONTACT_EMAIL}`, status: 'contact' },
];
---

<MarketingShell
  title="Ways to Give — P31 Labs"
  description="Every path a donation can take — and where it goes. Only live destinations are listed; nothing is faked."
>
  <main id="main-content" class="section">
    <div class="waa0-max-w-5xl waa0-mx-auto waa0-px-6 waa0-md-px-12 waa0-lg-px-16">
      <SectionHeader
        level="1"
        title="Ways to Give"
        description="Every path a donation can take — and where it goes."
        align="left"
      />

      <div class="waa0-mt-16 waa0-space-y-8">

        {/* ── THE TREASURY FLOW ── */}
        <section class="glass-card">
          <div class="waa0-p-8 waa0-space-y-6">
            <h2 class="waa0-text-2xl waa0-font-bold" style="color: var(--p31-text);">Where the money goes</h2>
            <pre class="mermaid" set:html={treasuryFlow} />
            <p class="waa0-text-sm" style="color: var(--p31-text-secondary);">
              P31 Labs, Inc. — a Georgia nonprofit corporation, EIN 42-1888158, 501(c)(3) determination granted (effective 2026-04-03). Donations are tax-deductible to the fullest extent of the law.
            </p>
          </div>
        </section>

        {/* ── THE PATHS ── */}
        <section>
          <div data-p31="grid" data-cols="2" data-even class="waa0-gap-4">
            {paths.map((p) => (
              p.status === 'active' || p.status === 'contact' ? (
                <a
                  key={p.label}
                  href={p.href!}
                  target={p.href?.startsWith('mailto') ? undefined : '_blank'}
                  rel="noopener noreferrer"
                  class="glass-card waa0-p-6 waa0-rounded-xl waa0-block waa0-transition"
                  style="border: 1px solid var(--p31-glass-border, rgba(255,255,255,0.1));"
                >
                  <div class="waa0-flex waa0-items-center waa0-justify-between waa0-gap-3">
                    <h3 class="waa0-text-lg waa0-font-bold" style="color: var(--p31-text);">{p.label}</h3>
                    <span class="waa0-shrink-0 waa0-text-xs waa0-font-mono waa0-px-2 waa0-py-0-5 waa0-rounded-full" style="background: color-mix(in oklch, var(--p31-accent-green) 15%, transparent); color: var(--p31-accent-green);">
                      {p.status === 'contact' ? 'contact' : 'active'}
                    </span>
                  </div>
                  <p class="waa0-mt-2 waa0-text-sm waa0-leading-relaxed" style="color: var(--p31-text-secondary);">{p.desc}</p>
                </a>
              ) : (
                <div key={p.label} class="glass-card waa0-p-6 waa0-rounded-xl" style="border: 1px dashed var(--p31-glass-border, rgba(255,255,255,0.14)); opacity: 0.85;">
                  <div class="waa0-flex waa0-items-center waa0-justify-between waa0-gap-3">
                    <h3 class="waa0-text-lg waa0-font-bold" style="color: var(--p31-text);">{p.label}</h3>
                    <span class="waa0-shrink-0 waa0-text-xs waa0-font-mono waa0-px-2 waa0-py-0-5 waa0-rounded-full" style="background: color-mix(in oklch, var(--p31-accent) 12%, transparent); color: var(--p31-accent);">
                      coming
                    </span>
                  </div>
                  <p class="waa0-mt-2 waa0-text-sm waa0-leading-relaxed" style="color: var(--p31-text-secondary);">{p.desc}</p>
                </div>
              )
            ))}
          </div>
        </section>

        {/* ── CTA ── */}
        <section class="waa0-text-center waa0-py-6">
          <a href="/donate" class="waa0-inline-flex waa0-items-center waa0-gap-2 waa0-rounded-full waa0-px-8 waa0-py-4 waa0-text-lg waa0-font-semibold waa0-transition"
             style="background: var(--p31-accent, #22d3ee); color: #0a0a0f;">
            Make a one-time gift →
          </a>
        </section>

      </div>
    </div>
  </main>

  <Footer />
</MarketingShell>