---
/**
 * /donate — the donation landing surface.
 *
 * Link-out only: every channel below is an external destination. There is
 * NO payment logic in this repository — no invoice creation, no checkout
 * embed, no payment processor call. The page hands the visitor to a hosted
 * channel and gets out of the way.
 *
 * Every href resolves from src/data/p31-mesh-constants.json (the
 * verify-content-consistency allowlist). No feature is gated on donating.
 */
import MarketingShell from '../layouts/MarketingShell.astro';
import SectionHeader from '../components/marketing/SectionHeader.astro';
import Footer from '../components/marketing/Footer.astro';
import constants from '../data/p31-mesh-constants.json';

const channels = [
  {
    key: 'opencollective',
    label: 'Open Collective',
    href: constants.openCollectiveUrl,
    desc: 'Transparent, recurring giving with a public ledger. See exactly where every dollar goes.',
    note: 'Fiscal hosting being finalized.',
  },
  {
    key: 'github-sponsors',
    label: 'GitHub Sponsors',
    href: constants.githubSponsorsUrl,
    desc: 'Sponsor the open-source work on GitHub. Recurring, and one-time tiers.',
    note: 'Profile pending platform approval.',
  },
  {
    key: 'btcpay',
    label: 'Bitcoin / BTCPay',
    href: constants.btcpayDonateUrl,
    desc: 'Self-hosted, no-processor crypto donations — for donors who value privacy.',
    note: 'Self-hosted, no middleman, no fees.',
  },
];
---

<MarketingShell
  theme="sunlight"
  title="Donate — P31 Labs"
  description="Support P31 Labs, a 501(c)(3) public charity. The software stays free — grants and donations fund the work. Give via Open Collective, GitHub Sponsors, or self-hosted BTCPay."
>
  <main id="main-content" class="section">
    <div class="doa1-max-w-4xl doa1-mx-auto doa1-px-6 doa1-md-px-12 doa1-lg-px-16">
      <SectionHeader
        level="1"
        title="Support P31 Labs"
        description="The software stays free. Grants and donations fund the work — we do not sell the software, and no feature is ever locked behind a donation."
        align="left"
      />

      <div class="doa1-mt-12 doa1-space-y-8">

        {/* ── THE 501(c)(3) STATEMENT (verbatim) ── */}
        <section class="glass-card">
          <div class="doa1-p-8">
            <p class="doa1-text-sm doa1-leading-relaxed" style="color: var(--p31-text-secondary);">
              P31 Labs, Inc. is a 501(c)(3) tax-exempt public charity (EIN 42-1888158;
              exemption effective 2026-04-03). Contributions are tax-deductible to the
              extent allowed by law. Your gift funds free, privacy-preserving software
              for neurodivergent people and family caregivers.
              <strong style="color: var(--p31-text);">The software stays free — grants and
              donations fund the work, we do not sell the software.</strong>
            </p>
          </div>
        </section>

        {/* ── CHANNELS (link-out only) ── */}
        <section>
          <h2 class="doa1-text-lg doa1-font-bold doa1-mb-5" style="color: var(--p31-text);">Ways to give</h2>
          <div data-p31="grid" data-cols="3" data-even class="doa1-gap-4">
            {channels.map((c) => (
              <a
                href={c.href}
                target="_blank"
                rel="noopener noreferrer"
                class="glass-card doa1-p-6 doa1-rounded-xl doa1-block doa1-transition"
                style="border: 1px solid var(--p31-glass-border, rgba(255,255,255,0.1));"
              >
                <h3 class="doa1-text-base doa1-font-bold doa1-mb-2" style="color: var(--p31-text);">{c.label}</h3>
                <p class="doa1-text-sm doa1-leading-relaxed" style="color: var(--p31-text-secondary);">{c.desc}</p>
                <p class="doa1-mt-3 doa1-text-xs doa1-font-mono" style="color: var(--p31-text-tertiary);">{c.note}</p>
              </a>
            ))}
          </div>
        </section>

        {/* ── PRINCIPLE ── */}
        <section class="doa1-text-center doa1-py-4">
          <p class="doa1-text-sm doa1-max-w-xl doa1-mx-auto" style="color: var(--p31-text-tertiary);">
            Every channel above opens on the provider's own site. We never handle your
            payment details, and we never gate the software on a gift.
          </p>
        </section>

      </div>
    </div>
  </main>

  <Footer />
</MarketingShell>
