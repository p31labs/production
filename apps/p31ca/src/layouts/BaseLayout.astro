---
import MarketingShell from './MarketingShell.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  theme?: string;
  background?: 'dome' | 'heart' | 'calm-gradient' | 'mesh' | 'none';
}

const { title, description, canonical, theme = 'sunlight', background = 'calm-gradient' } = Astro.props;
---

<MarketingShell title={title} description={description} canonical={canonical} theme={theme} background={background}>
  <slot />
</MarketingShell>