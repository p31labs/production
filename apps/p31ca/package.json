{
  "name": "p31ca",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/verify-ground-truth.mjs && node scripts/verify-content-sources.mjs && node scripts/verify-content-consistency.mjs && node scripts/verify-compliance-drift.mjs && (node scripts/fetch-substack.mjs || true)",
    "build": "astro build",
    "fetch:love": "node scripts/fetch-love-stats.mjs",
    "fetch:stats": "node scripts/fetch-content-stats.mjs",
    "preview": "astro preview",
    "deploy": "npx wrangler pages deploy dist --project-name p31ca --branch=main --commit-dirty=true",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/react": "^5.0.4",
    "@astrojs/tailwind": "^6.0.2",
    "@p31ca/controls": "workspace:*",
    "@p31ca/design-core": "workspace:*",
    "@p31ca/shared": "workspace:*",
    "@p31ca/shared-identity": "workspace:*",
    "@p31ca/shell-chrome": "workspace:*",
    "@p31ca/ui": "workspace:*",
    "astro": "^5.17.1",
    "mermaid": "^12.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rehype-mermaid-lite": "^1.1.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "^12.6.13",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "wrangler": "^4.85.0"
  },
  "private": true
}
