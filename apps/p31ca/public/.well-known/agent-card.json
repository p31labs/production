{
  "schemaVersion": "https://schema.a2a.dev/agent-card/v0.2.2",
  "kind": "agent",
  "name": "P31 Labs",
  "description": "Open-source neuroinclusive assistive technology for neurodivergent individuals and families. Agent-native: CLI, MCP servers (4 servers, ~46 tools), and agent-card.json discovery.",
  "url": "https://gateway.p31ca.org",
  "preferredTransport": "jsonrpc",
  "provider": {
    "organization": "P31 Labs",
    "url": "https://p31ca.org"
  },
  "version": "1.0.0",
  "capabilities": {
    "streaming": false,
    "pushNotifications": false,
    "stateTransitionHistory": false
  },
  "authentication": {
    "schemes": ["Bearer"]
  },
  "defaultInputModes": ["text/plain", "application/json"],
  "defaultOutputModes": ["text/plain", "application/json"],
  "skills": [
    {
      "id": "oasis-cli",
      "name": "Oasis CLI",
      "description": "Interactive TUI with --agent JSON mode and MCP server (11 tools).",
      "tags": ["cli", "developer-tools", "agent-native", "neuroinclusive"],
      "examples": ["andromeda --agent", "andromeda status --agent"]
    },
    {
      "id": "component-registry",
      "name": "Component Registry",
      "description": "Queryable design system for agent-generated UI (5 tools). Spoon-aware.",
      "tags": ["design-system", "component-registry", "spoon-aware"],
      "examples": ["design_list_components", "design_get_component GlassPanel"]
    },
    {
      "id": "love-ledger",
      "name": "LOVE Ledger",
      "description": "Privacy-preserving care accounting ledger (3 tools).",
      "tags": ["love-economy", "soulbound", "care-accounting"],
      "examples": ["love_status", "love_balance"]
    },
    {
      "id": "phos-forge",
      "name": "PHOS Forge",
      "description": "Studio MCP server for cognitive-state, healer, cartographer, and surface management (27 tools).",
      "tags": ["phos", "forge", "cognitive-state", "mcp"],
      "examples": ["phos-status", "cartographer-query"]
    }
  ]
}
