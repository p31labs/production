---
import ArcadeLayout from '../layouts/ArcadeLayout.astro';
import Leaderboard from '../components/Leaderboard.tsx';
---

<ArcadeLayout title="LOVE Arcade — Leaderboard">
  <div style="max-width: 48rem; margin: 0 auto; padding: 32px 24px;">
    <div style="text-align: center; margin-bottom: 40px;">
      <h1 style="font-size: 2rem; font-weight: 700; color: #FBBF24; margin-bottom: 8px;">Leaderboard</h1>
      <p style="color: rgba(245,245,247,0.5); font-size: 0.95rem;">
        Top LOVE earners across all games. Every care event counts.
      </p>
    </div>

    <Leaderboard client:load />
  </div>
</ArcadeLayout>
