---
/**
 * P31Shell.astro — Shared layout for P31 Astro applications.
 * Provides common structure for p31ca and phosphorus31 with configurable branding.
 */

import '@p31/design-core/css/base.css';
import '@p31/design-core/css/glass.css';
import '@p31/design-core/css/motion.css';
import '@p31/design-core/css/typography.css';
import '@p31/design-core/css/size-class.css';
import '@p31/design-core/css/ambient.css';
import '@p31/design-core/css/container.css';
import '@p31/design-core/css/quantum.css';
import '@p31/design-core/css/link-glow.css';

interface Props {
  brand?: 'p31ca' | 'phosphorus31' | 'phos' | 'willow';
  theme?: string;
  title?: string;
  description?: string;
}

const {
  brand = 'p31ca',
  theme = 'quantum',
  title = 'P31 Labs',
  description = 'Built for neurodivergent families. Verifiable, inclusive, and open.',
} = Astro.props;
---
<!doctype html>
<html lang="en" data-brand={brand} data-spoons="3" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050508" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Atkinson Hyperlegible — accessibility-first -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400;1,700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400;1,700&family=JetBrains+Mono:wght@400;500;700&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://p31ca.org" />
    <meta property="og:image" content="/og-image.svg" />
    <meta name="twitter:image" content="/og-image.svg" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body class="min-h-screen text-white/85 antialiased" style="overflow-x: hidden;">
    <!-- Skip link -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <!-- Ambient starfield background — molecular nebula -->
    <div class="fixed inset-0 pointer-events-none" aria-hidden="true" style="background-image: radial-gradient(circle at 50% -20%, rgba(6,182,212,0.12) 0%, transparent 55%), radial-gradient(circle at 10% 80%, rgba(16,185,129,0.07) 0%, transparent 45%), radial-gradient(circle at 90% 90%, rgba(139,92,246,0.07) 0%, transparent 45%); background-color: var(--p31-void, #030712);"></div>

    <!-- Layout shell (LandingShell, WorkspaceShell, or ConversationShell) renders here -->
    <slot />

    <!-- Crisis breathing overlay — shows only at spoons=0, hidden otherwise by chrome.css -->
    <p31-crisis-overlay message="Rest. Breathe. The mesh holds. Exit when ready." button-label="I'm Ready"></p31-crisis-overlay>

    <!-- ═══ SCRIPTS ═══ -->
    <script is:inline>
      // Read saved spoon level before React hydrates (prevents flash of wrong state)
      (function () {
        var spoons = parseInt(localStorage.getItem('p31:spoons') || '3', 10);
        document.documentElement.setAttribute('data-spoons', String(spoons));
      })();
      // Responsive size-class + input mode (runs before React hydrates)
      (function () {
        var w = window.innerWidth;
        var sc = 'regular';
        if (w <= 480) sc = 'compact';
        else if (w >= 768 && w <= 1023) sc = 'medium';
        else if (w >= 1024) sc = 'expanded';
        document.documentElement.dataset.sizeClass = sc;
        var hasTouch = window.matchMedia('(pointer: coarse)').matches;
        var hasMouse = window.matchMedia('(pointer: fine)').matches;
        document.documentElement.dataset.input = hasTouch && hasMouse ? 'hybrid' : hasTouch ? 'touch' : 'mouse';
      })();
    </script>

    <!-- Register design-core crisis overlay web component -->
    <script>
      import { registerP31CrisisOverlay } from '@p31/design-core/crisis-overlay';
      registerP31CrisisOverlay();
    </script>

    <!-- Unified skin engine — aligns inline themes with @p31/skin-system -->
    <script type="module" src="/lib/p31-skin-engine.mjs"></script>
    <script is:inline>
      // Apply saved skin before first paint
      (function () {
        var saved = localStorage.getItem('p31:skin');
        if (saved && typeof applySkin === 'function') {
          applySkin(saved);
        }
      })();
    </script>

    <!-- Starfield engine — design-core (same engine as the god dashboard) -->
    <script>
      import { mountStarfield } from '@p31/design-core/starfield';

      // Bright config for spoon levels 2–5. Crisis levels 0–1 stay dim per spec.
      const BRIGHT = {
        baseAlpha: 0.85,
        count: 180,
        speed: 0.12,
        connR: 110,
        tealGlowA: 0.15,
        hearthA: 0.25,
      };

      try {
        const spoons = parseInt(
          document.documentElement.getAttribute('data-spoons') || '3',
          10
        );

        const instance = mountStarfield(undefined, { spoons });
        window.__p31starfield = instance;

        // Unified spoon handler: updates starfield + brightness boost.
        // Crown visibility is pure CSS via html[data-spoons="X"] .cr-*.
        window.applySpoons = (s) => {
          instance.setSpoons(s);
          if (s >= 2) {
            instance.setConfig(BRIGHT);
          }
        };
        window.applySpoons(spoons);

        // Reduced motion: SMIL <animateMotion> is not stopped by CSS, so strip it.
        if (
          window.matchMedia &&
          window.matchMedia('(prefers-reduced-motion: reduce)').matches
        ) {
          document
            .querySelectorAll('.orb animateMotion')
            .forEach((a) => a.remove());
        }
      } catch (err) {
        console.warn('P31: Starfield engine bypassed (fallback mode).', err);
        document.documentElement.setAttribute('data-starfield-error', 'true');
      }
    </script>
  </body>
</html>
