[
  { "id": "start", "type": "start",
    "outputs": { "next": { "elementId": "check-coding" } } },
  { "id": "check-coding", "type": "conditional",
    "properties": { "conditions": { "metadata.task": { "$eq": "coding" } } },
    "outputs": { "true": { "elementId": "model-kimi-code" },
                 "false": { "elementId": "check-reasoning" } } },
  { "id": "check-reasoning", "type": "conditional",
    "properties": { "conditions": { "metadata.task": { "$eq": "reasoning" } } },
    "outputs": { "true": { "elementId": "model-deepseek-r1" },
                 "false": { "elementId": "check-synthesis" } } },
  { "id": "check-synthesis", "type": "conditional",
    "properties": { "conditions": { "metadata.task": { "$eq": "synthesis" } } },
    "outputs": { "true": { "elementId": "model-kimi-k2.6" },
                 "false": { "elementId": "model-llama-scout" } } },
  { "id": "model-kimi-code", "type": "model",
    "properties": { "provider": "workers-ai",
                    "model": "@cf/moonshotai/kimi-k2.7-code",
                    "timeout": 120000, "retries": 1 },
    "outputs": { "success": { "elementId": "end" },
                 "fallback": { "elementId": "model-kimi-k2.6" } } },
  { "id": "model-deepseek-r1", "type": "model",
    "properties": { "provider": "workers-ai",
                    "model": "@cf/deepseek-ai/deepseek-r1-distill-qwen-32b",
                    "timeout": 120000, "retries": 1 },
    "outputs": { "success": { "elementId": "end" },
                 "fallback": { "elementId": "model-kimi-k2.6" } } },
  { "id": "model-kimi-k2.6", "type": "model",
    "properties": { "provider": "workers-ai",
                    "model": "@cf/moonshotai/kimi-k2.6",
                    "timeout": 120000, "retries": 1 },
    "outputs": { "success": { "elementId": "end" },
                 "fallback": { "elementId": "model-llama-scout" } } },
  { "id": "model-llama-scout", "type": "model",
    "properties": { "provider": "workers-ai",
                    "model": "@cf/meta/llama-4-scout-17b-16e-instruct",
                    "timeout": 60000, "retries": 2 },
    "outputs": { "success": { "elementId": "end" } } },
  { "id": "end", "type": "end", "outputs": {} }
]